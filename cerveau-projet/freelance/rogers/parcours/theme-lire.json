{
  "identite": {
    "type": "theme",
    "appartient_a": "rogers",
    "nom": "LIRE",
    "description": "Consulter, chercher, comprendre les regles, conventions et protocoles existants"
  },
  "theme": {
    "nom": "LIRE",
    "but": "Acceder a la connaissance des regles",
    "redirects": [
      {
        "besoin": "Lire les regles immuables",
        "action": "redirection",
        "vers": {
          "type": "fichier",
          "chemin": "cerveau-projet/freelance/regles/regles-immuables.md",
          "commande": "lire-fichier"
        }
      },
      {
        "besoin": "Lire les conventions",
        "action": "redirection",
        "vers": {
          "type": "fichier",
          "chemin": "cerveau-projet/freelance/conventions/conventions.md",
          "commande": "lire-fichier"
        }
      },
      {
        "besoin": "Lire les protocoles",
        "action": "redirection",
        "vers": {
          "type": "fichier",
          "chemin": "cerveau-projet/freelance/protocoles/protocoles.md",
          "commande": "lire-fichier"
        }
      },
      {
        "besoin": "Chercher une regle par mot-cle",
        "action": "redirection",
        "vers": {
          "type": "outil",
          "commande": "rechercher-texte",
          "parametres": {"dossier": "cerveau-projet/freelance/regles/"}
        }
      },
      {
        "besoin": "Consulter les lecons liees aux regles",
        "action": "redirection",
        "vers": {
          "type": "outil",
          "commande": "consulter-lecons",
          "parametres": {"agent": "rogers", "domaine": "regles"}
        }
      },
      {
        "besoin": "Voir l'activite recente",
        "action": "redirection",
        "vers": {
          "type": "outil",
          "commande": "lire-activite-recente"
        }
      }
    ]
  },
  "fin": {
    "type": "lien",
    "vers": "fins.json",
    "case": "fin-theme"
  }
}
