{
  "identite": {
    "type": "theme",
    "appartient_a": "rogers",
    "nom": "EXPLORER",
    "description": "Diagnostiquer, comprendre un probleme"
  },
  "theme": {
    "nom": "EXPLORER",
    "but": "Comprendre pourquoi quelque chose ne va pas",
    "redirects": [
      {
        "besoin": "Diagnostiquer un conflit de regles",
        "action": "procedure",
        "etapes": [
          "Identifier les deux regles en conflit",
          "Lire le contexte de chaque regle",
          "Determiner quelle regle a priorite",
          "Proposer une resolution",
          "Documenter la decision"
        ]
      },
      {
        "besoin": "Comprendre pourquoi un agent viole une regle",
        "action": "procedure",
        "etapes": [
          "Lire l'arbre de decision de l'agent",
          "Verifier que la regle est presente dans son arbre",
          "Si absente -> l'ajouter (MODIFIER)",
          "Si presente -> verifier si elle est claire",
          "Si ambigue -> la reformuler (MODIFIER)"
        ]
      },
      {
        "besoin": "Auditer la coherence globale",
        "action": "redirection",
        "vers": {
          "type": "procedure",
          "etapes": [
            "Lire les 3 piliers (regles, conventions, protocoles)",
            "Verifier la coherence entre les 3",
            "Verifier que les agents respectent les themes (D8)",
            "Verifier que les fins sont correctes",
            "Donner un rapport de coherence"
          ]
        }
      },
      {
        "besoin": "Consulter les lecons pour comprendre un probleme recurrent",
        "action": "redirection",
        "vers": {
          "type": "outil",
          "commande": "consulter-lecons",
          "parametres": {"agent": "tous", "domaine": "regles"}
        }
      }
    ]
  },
  "fin": {
    "type": "lien",
    "vers": "fins.json",
    "case": "fin-theme"
  }
}
