{
  "identite": {
    "type": "theme",
    "appartient_a": "forge",
    "nom": "EXPLORER",
    "description": "Diagnostiquer un probleme d'outil"
  },
  "theme": {
    "nom": "EXPLORER",
    "but": "Comprendre pourquoi un outil ne fonctionne pas",
    "redirects": [
      {
        "besoin": "Diagnostiquer un outil defaillant",
        "action": "procedure",
        "etapes": [
          "Lire le .md de l'outil",
          "Verifier que le -data.json existe et est valide",
          "Verifier que le .py lit bien le -data.json",
          "Tester l'outil avec des donnees simples",
          "Identifier l'erreur"
        ]
      },
      {
        "besoin": "Comprendre pourquoi un formulaire est rejete",
        "action": "procedure",
        "etapes": [
          "Lire les messages d'erreur",
          "Verifier le formulaire (D7)",
          "Verifier les types et les champs requis",
          "Corriger le formulaire"
        ]
      },
      {
        "besoin": "Consulter les lecons d'outils",
        "action": "redirection",
        "vers": {"type": "outil", "commande": "consulter-lecons", "parametres": {"agent": "forge", "domaine": "outils"}}
      }
    ]
  },
  "fin": {"type": "lien", "vers": "fins.json", "case": "fin-theme"}
}
