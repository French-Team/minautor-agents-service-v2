#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
bdd-modifs/fonctions/bdd_modifs.py -- Fonctions atomiques BDD modifications
"""

import sqlite3
from datetime import datetime
from pathlib import Path
from typing import Optional, List, Dict, Any

# --- Vocabulaire des STATUTS : UN seul domicile (la ou le schema les declare) ---
#
# Mesure MO-127 : 'verrouille' / 'valide' / 'annule' etaient recopies CINQ fois
# -- dans le DEFAULT du schema, dans l'INSERT, dans les deux UPDATE et dans les
# choix de la porte -- et l'espion d'activite les interrogeait en clair. Meme
# remede que MO-126 pour les frictions : le vocabulaire se declare ICI, tout le
# reste le CONSOMME (L-029 : un contrat se declare a UN domicile).
STATUT_VERROUILLE = "verrouille"
STATUT_VALIDE = "valide"
STATUT_ANNULE = "annule"
STATUTS = (STATUT_VERROUILLE, STATUT_VALIDE, STATUT_ANNULE)


def init_db(db_path: Path):
    """Initialiser la BDD modifications"""
    db_path.parent.mkdir(parents=True, exist_ok=True)
    with sqlite3.connect(db_path) as conn:
        conn.execute(f"""
            CREATE TABLE IF NOT EXISTS modifications (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                date TEXT NOT NULL,
                fichier TEXT NOT NULL,
                hash_avant TEXT NOT NULL,
                hash_apres TEXT NOT NULL,
                diff TEXT NOT NULL,
                raison TEXT NOT NULL,
                friction_id INTEGER NOT NULL,
                statut TEXT NOT NULL DEFAULT '{STATUT_VERROUILLE}'
            )
        """)
        conn.execute("CREATE INDEX IF NOT EXISTS idx_modifs_fichier ON modifications(fichier)")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_modifs_statut ON modifications(statut)")
        conn.commit()


def ajouter_modif(
    db_path: Path,
    fichier: str,
    hash_avant: str,
    hash_apres: str,
    diff: str,
    raison: str,
    friction_id: int,
) -> int:
    """Ajouter une modification, retourner l'ID"""
    date = datetime.now().strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
    with sqlite3.connect(db_path) as conn:
        cur = conn.execute(
            """
            INSERT INTO modifications (date, fichier, hash_avant, hash_apres, diff, raison, friction_id, statut)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (date, fichier, hash_avant, hash_apres, diff, raison, friction_id, STATUT_VERROUILLE),
        )
        conn.commit()
        return cur.lastrowid


def verrouiller_fichier(db_path: Path, fichier: str):
    """Verrouiller un fichier (marquer comme en cours de modification)"""
    # Verifier s'il y a deja un verrou actif
    with sqlite3.connect(db_path) as conn:
        cur = conn.execute(
            "SELECT id FROM modifications WHERE fichier = ? AND statut = ?",
            (fichier, STATUT_VERROUILLE),
        )
        if cur.fetchone():
            raise RuntimeError(f"Fichier deja verrouille: {fichier}")
    # Le verrou est cree via ajouter_modif avec statut 'verrouille'


def deverrouiller_fichier(db_path: Path, fichier: str):
    """Deverrouiller un fichier (passer a valide)"""
    with sqlite3.connect(db_path) as conn:
        conn.execute(
            "UPDATE modifications SET statut = ? WHERE fichier = ? AND statut = ?",
            (STATUT_VALIDE, fichier, STATUT_VERROUILLE),
        )
        conn.commit()


def annuler_modif(db_path: Path, fichier: str, raison: str):
    """Annuler une modification (passer a annule)"""
    with sqlite3.connect(db_path) as conn:
        conn.execute(
            "UPDATE modifications SET statut = ?, raison = ? WHERE fichier = ? AND statut = ?",
            (STATUT_ANNULE, raison, fichier, STATUT_VERROUILLE),
        )
        conn.commit()


def lister_modifs(
    db_path: Path,
    fichier: Optional[str] = None,
    statut: Optional[str] = None,
    limite: int = 20,
) -> List[Dict[str, Any]]:
    """Lister les modifications"""
    with sqlite3.connect(db_path) as conn:
        conn.row_factory = sqlite3.Row
        query = "SELECT * FROM modifications WHERE 1=1"
        params = []
        if fichier:
            query += " AND fichier = ?"
            params.append(fichier)
        if statut:
            query += " AND statut = ?"
            params.append(statut)
        query += " ORDER BY date DESC LIMIT ?"
        params.append(limite)
        cur = conn.execute(query, params)
        return [dict(row) for row in cur.fetchall()]