#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
bdd-modifs -- BDD des modifications (auto-evolution Optimus Prime)

Point d'entree global. Dirige vers la categorie demandee.
"""

import sys
import os

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from entry import run as run_modifs


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        print("\nUsage:")
        print("  bdd-modifs ajouter --fichier <path> --hash-avant <h> --hash-apres <h> --diff <txt> --raison <txt> --friction-id <id>")
        print("  bdd-modifs verrouiller --fichier <path>")
        print("  bdd-modifs deverrouiller --fichier <path>")
        print("  bdd-modifs annuler --fichier <path> --raison <txt>")
        print("  bdd-modifs lister [--fichier <path>] [--statut <statut>] [--n <nb>]")
        return 1

    cmd = sys.argv[1]
    args = sys.argv[2:]

    if cmd == "ajouter":
        return run_modifs("ajouter", args)
    elif cmd == "verrouiller":
        return run_modifs("verrouiller", args)
    elif cmd == "deverrouiller":
        return run_modifs("deverrouiller", args)
    elif cmd == "annuler":
        return run_modifs("annuler", args)
    elif cmd == "lister":
        return run_modifs("lister", args)
    else:
        print(f"Commande inconnue: {cmd}")
        return 1


if __name__ == "__main__":
    sys.exit(main())