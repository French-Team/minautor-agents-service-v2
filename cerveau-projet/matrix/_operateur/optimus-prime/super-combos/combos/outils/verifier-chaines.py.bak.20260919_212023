"""Garde : le STATUT des cartes de chaine est-il declare ET coherent ? (MO-246)

Constat N6 de l audit MO-220 : le statut porte dans la carte d identite des documents
d une chaine n etait verifie par AUCUN controle -- une colonne vide se lit comme un fait.
Ce garde est PERMANENT : il tourne dans le lanceur de non-regression, jamais dans un
cobaye jetable qui meurt avec tmp-optimus.

REGLE (lue au domicile, jamais recopiee -- M-076) : les etapes fermees, la
correspondance etape -> champ et la correspondance etape -> prefixe viennent de
l outil chaine-pense-bete (constants.py : ETAPES, CHAMPS_ETAPE, PREFIXES).
Pour chaque document qui porte type: chaine :
  1. le champ statut est PRESENT et NON VIDE (un vide ne se lit pas comme un fait) ;
  2. sa valeur appartient aux etapes fermees ;
  3. les champs d ids presents forment un PREFIXE des etapes : une chaine au stade
     spec porte pense-bete et spec, JAMAIS todo (un id trop avance est une incoherence) ;
  4. la FAMILLE de chaque id correspond a sa cle (PB avec pense-bete, SP avec spec,
     TD avec todo), prefixes lus a la declaration ;
  5. la PLAGE de chaque id : son numero ne depasse PAS le compteur de sa famille (lu au
     domicile, chaine-compteurs.json) -- un id hors plage n a jamais ete emis (MO-247) ;
  6. l index des chaines annonce le MEME statut pour le meme id -- deux sources pour un
     fait, c est une divergence qui s ecrit en silence.

PREUVE (lecon L-032) : l autotest porte HUIT epreuves, dont la chaine COHERENTE qui
doit rester NON accusee (un garde qui accuse tout passerait les six autres) ET le
CONTRE-TEMOIN de la lecture d AVANT (un statut vide saute comme un etat initial) :
sur le MEME cobaye, elle ne voit RIEN.

TROU RESTANT, DIT (mesure du 2026-09-19, cobaye MO-246) : sur un statut HORS LISTE, la
porte chaine-pense-bete ne REFUSE pas -- elle LEVE (ETAPES.index) au lieu de nommer le
remede. Ce garde l accuse AVANT que la porte ne soit atteinte ; la porte garde son trou.
"""
import argparse
import importlib.util
import json
import shutil
import sys
import tempfile
from pathlib import Path

ZONE = Path("_operateur") / "optimus-prime" / "preparation"
CHEMIN_DECLARATION = ("matrice", "data", "outils", "chaine-pense-bete", "constants.py")
NOM_MODULE = "etapes_declarees_par_la_chaine"
NOM_ETAPES = "ETAPES"
NOM_CHAMPS = "CHAMPS_ETAPE"
NOM_PREFIXES = "PREFIXES"
NOM_INDEX = "index-chaine.md"
NOM_COMPTEURS = "chaine-compteurs.json"
EXTENSION = ".md"
TYPE_CHAINE = "chaine"
CLE_TYPE = "type"
CLE_STATUT = "statut"


def lire_declaration(racine):
    """(etapes, champs, prefixes, avis) : lus au DOMICILE de l outil chaine-pense-bete.

    Trois declarations sont CONSOMMEES, jamais recopiees : les etapes fermees, le nom
    du champ de carte de chaque etape et le prefixe de sa famille d ids. Une
    declaration INCOMPLETE est un AVIS : le trou est DIT, il ne se lit pas comme un vide.
    """
    chemin = Path(racine).joinpath(*CHEMIN_DECLARATION)
    if not chemin.is_file():
        return (), {}, {}, "declaration INTROUVABLE : " + str(chemin)
    try:
        specification = importlib.util.spec_from_file_location(NOM_MODULE, chemin)
        module = importlib.util.module_from_spec(specification)
        specification.loader.exec_module(module)
        etapes = tuple(getattr(module, NOM_ETAPES))
        champs = dict(getattr(module, NOM_CHAMPS))
        prefixes = dict(getattr(module, NOM_PREFIXES))
    except Exception as erreur:
        return (), {}, {}, ("declaration ILLISIBLE (" + type(erreur).__name__ + " : "
                            + str(erreur)[:60] + ")")
    if not etapes:
        return (), {}, {}, "liste des etapes VIDE : " + str(chemin)
    manquants = [etape for etape in etapes if etape not in champs or etape not in prefixes]
    if manquants:
        return (), {}, {}, ("declaration INCOMPLETE : " + ", ".join(manquants)
                            + " sans champ ou sans prefixe dans " + str(chemin))
    return etapes, champs, prefixes, ""


def familles_de(etapes, prefixes):
    """{etape: prefixe-} -- le tiret est la FORME de l id, jamais une donnee."""
    return {etape: prefixes[etape] + "-" for etape in etapes}


def nom_de_champ(champs, etape):
    """Le nom du champ de carte d une etape, lu a la DECLARATION (champ mort sinon)."""
    return champs[etape].rstrip(":")


def lire_compteurs(zone):
    """{prefixe: compteur} lus au DOMICILE de la zone, ou None (jamais un zero suppose).

    Le compteur dit le DERNIER id emis par la porte : un id dont le numero le depasse
    n a jamais ete emis (MO-247, decision createur arbitrage C). Un compteur ABSENT
    rend None -- la plage n est alors PAS jugee, elle est DITE et non supposee.
    """
    chemin = Path(zone) / NOM_COMPTEURS
    if not chemin.is_file():
        return None
    try:
        donnees = json.loads(chemin.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(donnees, dict):
        return None
    return {cle: valeur for cle, valeur in donnees.items() if isinstance(valeur, int)}


def carte_de(texte):
    """Les champs de la carte d identite, ou None si le document n en porte pas."""
    if not texte.startswith("---"):
        return None
    fin = texte.find("---", 3)
    if fin < 0:
        return None
    carte = {}
    for ligne in texte[3:fin].splitlines():
        morceau = ligne.strip()
        if not morceau or morceau.endswith(":") or ":" not in morceau:
            continue
        cle, valeur = morceau.split(":", 1)
        cle = cle.strip()
        if cle not in carte:
            carte[cle] = valeur.strip()
    return carte


def controler(nom, condition, detail=""):
    """Affiche et retourne un controle, au format des autres gardes."""
    print(("[OK] " if condition else "[KO] ") + nom + " : " + detail)
    return condition


def chaines_de_zone(zone):
    """Les documents de TYPE chaine de la zone, tries."""
    if not zone.is_dir():
        return None
    trouvees = []
    for chemin in sorted(zone.rglob("*" + EXTENSION)):
        try:
            texte = chemin.read_text(encoding="utf-8")
        except OSError:
            continue
        carte = carte_de(texte)
        if carte and carte.get(CLE_TYPE) == TYPE_CHAINE:
            trouvees.append((chemin, carte))
    return trouvees


def statuts_index(texte_index, prefixe):
    """Les statuts ANNONCES par l index : {PB-003: todo}.

    L index a une FORME FIXE (la porte chaine-pense-bete l ecrit) : elle se DECOUPE,
    elle ne se devine pas -- et aucun motif a echappement, car un avertissement de
    compilation dans la sortie d un controle est du bruit qui masque ses accusations.
    """
    annonces = {}
    for ligne in texte_index.splitlines():
        morceau = ligne.strip()
        if not morceau.startswith("- ") or "[" not in morceau or "]" not in morceau:
            continue
        avant, reste = morceau[2:].split("[", 1)
        identifiant = avant.strip()
        statut = reste.split("]", 1)[0].strip()
        if not identifiant.startswith(prefixe):
            continue
        if not identifiant[len(prefixe):].isdigit():
            continue
        annonces[identifiant] = statut
    return annonces


def controler_zone(zone, etapes, champs, prefixes):
    """Les six regles de la coherence du statut. Rend les six listes d ecarts."""
    familles = familles_de(etapes, prefixes)
    chaines = chaines_de_zone(zone)
    if chaines is None:
        return ["zone introuvable : " + str(zone)]
    if not chaines:
        return ["aucun document de type " + TYPE_CHAINE + " sous " + str(zone)]
    sans_statut, hors_liste, trop_avance, famille, hors_plage, index = [], [], [], [], [], []
    compteurs = lire_compteurs(zone)
    chemin_index = zone / NOM_INDEX
    annonces = {}
    if chemin_index.is_file():
        annonces = statuts_index(chemin_index.read_text(encoding="utf-8"),
                                 familles[etapes[0]])
    for chemin, carte in chaines:
        relatif = chemin.name
        statut = (carte.get(CLE_STATUT) or "").strip()
        if not statut:
            sans_statut.append(relatif)
            continue
        if statut not in etapes:
            hors_liste.append(relatif + " -> " + statut)
            continue
        rang = etapes.index(statut)
        identifiants = {etape: (carte.get(nom_de_champ(champs, etape)) or "").strip()
                        for etape in etapes}
        presents = [etape for etape in etapes if identifiants[etape]]
        if any(etapes.index(etape) > rang for etape in presents):
            trop_avance.append(relatif + " -> statut " + statut + " mais id "
                               + str([identifiants[etape] for etape in presents]))
        for etape in presents:
            identifiant = identifiants[etape]
            if not identifiant.startswith(familles[etape]):
                famille.append(relatif + " -> " + identifiant + " sous "
                               + nom_de_champ(champs, etape))
                continue
            if compteurs is not None:
                numero = identifiant[len(familles[etape]):]
                plafond = compteurs.get(prefixes[etape])
                if numero.isdigit() and isinstance(plafond, int) and int(numero) > plafond:
                    hors_plage.append(relatif + " -> " + identifiant + " > compteur "
                                      + str(plafond))
        identifiant_pb = identifiants[etapes[0]]
        if annonces and identifiant_pb in annonces and annonces[identifiant_pb] != statut:
            index.append(identifiant_pb + " : index dit " + annonces[identifiant_pb]
                         + ", la carte dit " + statut)
    return sans_statut, hors_liste, trop_avance, famille, hors_plage, index


def controler_zone_lisible(zone, etapes, champs, prefixes):
    """Rend True si tout tient, et DIT chaque regle."""
    resultats = controler_zone(zone, etapes, champs, prefixes)
    if isinstance(resultats, list):
        controler("zone-lisible", False, resultats[0])
        return False
    sans_statut, hors_liste, trop_avance, famille, index = resultats
    ok = True
    ok &= controler("statut-declare", not sans_statut,
                    "chaque chaine declare son statut"
                    if not sans_statut else "STATUT VIDE ou ABSENT : " + ", ".join(sans_statut))
    ok &= controler("statut-dans-la-liste", not hors_liste,
                    "les statuts viennent des etapes fermees (" + ", ".join(etapes) + ")"
                    if not hors_liste else "STATUT HORS LISTE : " + ", ".join(hors_liste))
    ok &= controler("prefixe-des-etapes", not trop_avance,
                    "aucun id plus avance que le statut"
                    if not trop_avance else "ID TROP AVANCE : " + " ; ".join(trop_avance))
    ok &= controler("famille-des-ids", not famille,
                    "PB- avec pense-bete, SP- avec spec, TD- avec todo"
                    if not famille else "FAMILLE FAUTIVE : " + ", ".join(famille))
    ok &= controler("id-dans-la-plage", not hors_plage,
                    "aucun id au-dela du compteur de sa famille"
                    if not hors_plage else "ID HORS PLAGE : " + ", ".join(hors_plage))
    ok &= controler("index-d-accord", not index,
                    "l index et les cartes disent le meme statut"
                    if not index else "INDEX EN DESACCORD : " + " ; ".join(index))
    return bool(ok)


def _cobaye(chemin, statut, ids, titre="Cobaye"):
    """Ecrit un document de chaine cobaye (front-matter minimal)."""
    lignes = ["---", "identite:", "  type: " + TYPE_CHAINE, "  appartient_a: optimus-prime",
              "  commun: false", "  titre: " + titre]
    if statut is not None:
        lignes.append("  statut: " + statut)
    for cle, valeur in ids:
        lignes.append("  " + cle + ": " + valeur)
    lignes += ["---", "", "# " + titre, ""]
    chemin.write_text("\n".join(lignes), encoding="utf-8", newline="\n")


def documents_sautes_par_ancienne_regle(zone, etapes):
    """CONTRE-TEMOIN (lecon L-032) : la lecture d AVANT, gardee pour etre ACCUSEE.

    `controler_nemesis` de la vigie-portes saute un document dont le statut est vide ou
    initial (`if not statut or statut in ETATS_INITIAUX: continue`). Le vide se lisait
    donc comme un fait. Cette fonction rejoue CETTE lecture et rend les documents
    qu elle a SAUTES : si elle devenait autre chose qu aveugle au vide, le defaut mesure
    par le constat N6 n etait pas reel.
    """
    sautes = []
    if not zone.is_dir():
        return sautes
    for chemin in sorted(zone.rglob("*" + EXTENSION)):
        try:
            texte = chemin.read_text(encoding="utf-8")
        except OSError:
            continue
        carte = carte_de(texte)
        if not carte:
            continue
        statut = (carte.get(CLE_STATUT) or "").strip()
        if not statut or statut == etapes[0]:
            sautes.append(chemin.name)
    return sautes


def controler_autotest(etapes, champs, prefixes):
    """Le garde se PIEGE (lecon L-032) : des cobayes JETABLES, hors projet.

    La SEPTIEME epreuve compte plus que les six autres : la chaine COHERENTE doit rester
    NON accusee -- un garde qui accuse tout passerait les six. Et le CONTRE-TEMOIN rejoue
    la lecture d AVANT sur le MEME cobaye, qu elle doit sauter.
    """
    racine = Path(tempfile.mkdtemp(prefix="cobayes-chaines-"))
    epreuves = []
    try:
        zone = racine / ZONE
        zone.mkdir(parents=True, exist_ok=True)
        _cobaye(zone / "coherente.md", "todo",
                [(etapes[0], "PB-901"), (etapes[1], "SP-901"), (etapes[2], "TD-901")], "Coherente")
        _cobaye(zone / "vide.md", "", [(etapes[0], "PB-902")], "Vide")
        _cobaye(zone / "hors.md", "termine", [(etapes[0], "PB-903")], "Hors liste")
        _cobaye(zone / "avance.md", "spec",
                [(etapes[0], "PB-904"), (etapes[1], "SP-904"), (etapes[2], "TD-904")], "Avance")
        _cobaye(zone / "famille.md", "todo",
                [(etapes[0], "SP-905"), (etapes[1], "SP-905"), (etapes[2], "TD-905")], "Famille")
        _cobaye(zone / "hors_plage.md", etapes[0], [(etapes[0], "PB-1000")], "Hors plage")
        _cobaye(zone / "desaccord.md", "spec",
                [(etapes[0], "PB-906"), (etapes[1], "SP-906")], "Desaccord")
        (zone / NOM_COMPTEURS).write_text(
            "{\"PB\": 999, \"SP\": 999, \"TD\": 999}", encoding="utf-8", newline="\n")
        (zone / NOM_INDEX).write_text("- PB-901 [todo] Coherente\n- PB-906 [todo] Desaccord\n",
                                      encoding="utf-8", newline="\n")
        resultats = controler_zone(zone, etapes, champs, prefixes)
        if isinstance(resultats, list):
            epreuves.append(("cobaye-lisible", False, resultats[0]))
        else:
            sans_statut, hors_liste, trop_avance, famille, hors_plage, index = resultats
            accusations = " | ".join(" ; ".join(liste) for liste in resultats)
            epreuves.append(("statut-vide-accuse", "vide.md" in sans_statut,
                             " ; ".join(sans_statut) or "silence"))
            epreuves.append(("statut-hors-liste-accuse", "hors.md" in " ".join(hors_liste),
                             " ; ".join(hors_liste) or "silence"))
            epreuves.append(("id-trop-avance-accuse", "avance.md" in " ".join(trop_avance),
                             " ; ".join(trop_avance) or "silence"))
            epreuves.append(("famille-fautive-accusee", "famille.md" in " ".join(famille),
                             " ; ".join(famille) or "silence"))
            epreuves.append(("index-en-desaccord-accuse", "PB-906" in " ".join(index),
                             " ; ".join(index) or "silence"))
            epreuves.append(("chaine-coherente-NON-accusee", "coherente.md" not in accusations,
                             "aucune accusation portee a la chaine coherente"))
            sautes = documents_sautes_par_ancienne_regle(zone, etapes)
            epreuves.append(("contre-temoin-ancienne-regle-AVEUGLE",
                             "vide.md" in sautes and "vide.md" in sans_statut,
                             "lecture d avant saute : " + (", ".join(sautes) or "rien")
                             + " | lecture d apres accuse : " + (", ".join(sans_statut) or "rien")))
    finally:
        shutil.rmtree(str(racine), ignore_errors=True)
    reussies = sum(1 for _, ok, _ in epreuves if ok)
    detail = ("piege (" + str(reussies) + "/" + str(len(epreuves)) + ")" if reussies == len(epreuves)
              else "rate : " + ", ".join(nom for nom, ok, _ in epreuves if not ok))
    return ("autotest-chaines", reussies == len(epreuves), detail)


def trouver_matrix(racine):
    """Retourne le dossier matrix/, ou None."""
    candidats = [racine / "cerveau-projet" / "matrix", racine / "matrix"]
    if racine.name == "matrix":
        candidats.insert(0, racine)
    for candidat in candidats:
        if (candidat / "matrice").is_dir():
            return candidat
    return None


def main():
    parser = argparse.ArgumentParser(description="Garde : statut des cartes de chaine declare ET coherent")
    parser.add_argument("--racine", default=".", help="Racine projet (defaut: cwd)")
    arguments = parser.parse_args()
    matrix = trouver_matrix(Path(arguments.racine).resolve())
    if matrix is None:
        print("Dossier matrix/ introuvable sous " + str(arguments.racine))
        return 2
    etapes, champs, prefixes, avis = lire_declaration(matrix)
    if avis:
        print("KO   declaration-lue : " + avis)
        return 1
    print("DECLARATION LUE AU DOMICILE : etapes " + ", ".join(etapes)
          + " | prefixes " + ", ".join(familles_de(etapes, prefixes)[etape] for etape in etapes))
    tenu = controler_zone_lisible(matrix / ZONE, etapes, champs, prefixes)
    autotest = controler_autotest(etapes, champs, prefixes)
    print("[--] " + autotest[0] + " : " + autotest[2])
    print("VERIFIER CHAINES -- une chaine dont le statut est vide ou en desaccord n a aucune verite")
    if not tenu or not autotest[1]:
        print("")
        print("VERDICT KO : le statut d une chaine est vide, hors liste, trop avance, mal famille ou en desaccord avec l index.")
        return 1
    print("")
    print("VERDICT OK : chaque chaine declare un statut coherent avec ses ids et avec l index.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
