"""Fonctions de l'alignement : chaque copie consomme le domicile, tout se dit."""
from commun import (
    auditer,
    bloc_fonction,
    construire_delegation,
    deriver_extras,
    lire_texte,
    publier,
)
from constants import RACINE


def extras_de(plan, rel, bloc):
    """Suffixe d'appel : DECLARE par le plan s'il l'est, sinon DEDUIT du texte.

    Le plan gagne toujours : c'est lui qui rattrape les cas que la deduction
    conservatrice ne peut pas voir (ex. `maintenir`, dont le drapeau `etat` ne
    marchait que par une valeur vide accidentelle -- mesure MO-171).
    """
    declares = plan.get("extras") or {}
    if rel in declares:
        return declares[rel]
    return deriver_extras(bloc) if plan.get("derive") else ""


def executer(plan, ecrire_vraiment=False):
    """Aligne les copies qui ne consomment pas le domicile. Rend un CODE d'etat."""
    rapport = auditer(plan)
    if rapport["hors_plan"]:
        print("REFUS : " + str(len(rapport["hors_plan"])) + " copie(s) hors plan -- aligner sur un plan incomplet ecrirait a l'aveugle.")
        for rel in rapport["hors_plan"]:
            print("  TROU : " + rel)
        return 2
    refus = 0
    for rel in rapport["a_aligner"]:
        bloc = bloc_fonction(lire_texte(RACINE / rel), plan["fonction"])
        if bloc is None:
            print("ECART : bloc de " + plan["fonction"] + " introuvable dans " + rel)
            refus += 1
            continue
        delegation = construire_delegation(plan, extras_de(plan, rel, bloc))
        code, message = publier(rel, bloc, delegation, simuler=not ecrire_vraiment)
        print(message)
        if code:
            refus += 1
    if not rapport["a_aligner"]:
        print("OK : aucune copie a aligner (" + str(len(rapport["alignees"])) + " deja alignee(s), " + str(len(rapport["exclues"])) + " exclue(s)).")
    elif ecrire_vraiment:
        print("Bilan : " + str(len(rapport["a_aligner"]) - refus) + " alignee(s), " + str(refus) + " refusee(s).")
    else:
        print("SIMULATION : rien n'a ete ecrit (" + str(len(rapport["a_aligner"])) + " copie(s) a aligner). Relancer avec --publier.")
    return 1 if refus else 0
