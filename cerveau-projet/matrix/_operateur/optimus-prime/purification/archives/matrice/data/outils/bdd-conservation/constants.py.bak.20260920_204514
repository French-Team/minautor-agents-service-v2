# --- LA PURGE DES ARCHIVES (MO-308 / P3) : ne meurt que RECOUVRABLE, PROUVEE ---
# Le createur a valide P3 le 2026-09-20 (rapport-revision-MO-305, section 3) :
# "une archive est SUPPRIMEE quand son contenu est prouve recouvrable (engage
# dans git, OU empreinte + copie dans la conservation BDD) ; sinon elle reste".
# Jusqu ici le registre DISAIT "aucune porte de suppression" : c etait vrai, et
# c est exactement ce qui faisait vivre 898 archives SANS duree de vie (V3 :
# 898 fichiers, 18 Mo, jamais relus). La porte ajoutee ici n a pas le droit de
# supprimer sur une PROMESSE -- elle supprime sur une PREUVE. Les DEUX modes de
# preuve sont donc DECLARES au domicile (M-076) et CONSOMMES par la porte : un
# mode de preuve recopie chez un appelant deriverait en silence.
#
# LA PREUVE `git` EST BIT A BIT (alignement du 2026-09-20) : `hash-object`
# applique les filtres de git, donc une archive CRLF "prouvait" un blob LF et la
# restauration rendait un AUTRE contenu que celui purge -- mesure : 5 des 826
# lignes du manifeste. Le mode `git` consomme donc `hash-object --no-filters`
# (NOM_SANS_FILTRES), et la forme seulement normalisee est un DIAGNOSTIC (elle se
# DIT dans le refus), jamais une preuve. Une seule preuve de recouvrabilite pour
# toute la Matrice : celle des archives datees.
STATUT_SUPPRIME = "supprime"
OPERATION_PURGER = "purger"
NOM_LIGNE_PURGE = "purge"
MOTIF_PREUVE_GIT = "git"
MOTIF_PREUVE_COPIE = "copie"
# Le programme juge par la preuve 1 : son NOM vit ici (zero valeur en dur).
