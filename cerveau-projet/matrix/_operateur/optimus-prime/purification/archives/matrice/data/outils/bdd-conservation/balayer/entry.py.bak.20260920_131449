"""Porte du BALAYAGE : appliquer la REGLE de la famille des points de restauration.

    python main.py balayer [--simuler oui] [--mission MO-XXX]

Le probleme qu'elle ferme (EO-147, 2026-09-17) : chaque ecriture cree un point de
restauration, donc chaque ecriture ajoute un element a classer, et le classement
exige trois marches. Faites a la main une par une, ces marches ne se terminent
jamais -- et une suite de purification qui ne se ferme pas n'est pas une suite.

TROIS PORTES DE SORTIE DU PERPETUEL. Un point echappe au balayage de TROIS
facons ; les deux premieres ont ferme EO-147, la troisieme ferme EO-152.

  1. le point est NEUF (present sur le disque, absent de la BDD) : personne ne l'a
     jamais vu, les TROIS marches sont a franchir (`propose -> classe -> decide`) ;
  2. le point est DECLARE mais son classement est INACHEVE (statut `propose` ou
     `classe`, aucun verdict) : la porte de l'acte ne le voit PAS -- elle ne
     regarde que les points ABSENTS de la BDD (`points_sans_decision`) -- et le
     balayage ne le voyait pas davantage. MESURE de la fermeture d'EO-147 : `K-156`,
     pose par MO-162, est reste a `propose` pendant que toute sa famille etait
     jugee. Un classement interrompu laissait donc un element INVISIBLE POUR
     TOUJOURS : une porte qui ne traite que le NEUF laisse derriere elle tout ce
     qui a echoue en route.
  3. le point est DEJA DECIDE `STRUCTUREL -> conserver` et un point plus recent
     l'a REMPLACE depuis (mesure MO-164, mission MO-165) : il n'est ni neuf (il est
     dans la BDD), ni inacheve (il a un verdict), donc les deux populations
     ci-dessus le laissaient hors de tout -- il gardait `conserver` POUR TOUJOURS
     et l'actif grandissait d'un point a chaque ecriture. MESURE : 16 points
     `STRUCTUREL` en trop dans 10 familles sur 88, et le controle qui devait le
     voir rendait "EN ORDRE". La regle le couvre pourtant ("tout point REMPLACE
     est OBSOLETE") : c'est la MACHINE qui ne l'appliquait pas. Ce point est
     RE-JUGE par la regle du jour, par la transition declaree `rejuger`
     (`ajouter.fonctions.rejuger_entree`).

  Les trois populations partagent les MEMES mots (`_textes`) : un element repris
  ou re-juge ne peut pas raconter autre chose qu'un element neuf, sinon le
  balayage aurait plusieurs verites selon la porte par laquelle on entre.

Trois garanties, dans cet ORDRE :

  1. les TROIS marches du plan sont franchies (`propose -> classe -> decide`) par
     les FONCTIONS de la porte qui les possede deja (`ajouter.fonctions`) : le
     balayage ORCHESTRE, il ne redecide NI les transitions NI les listes fermees ;
  2. ce que la regle ne couvre pas est DOUTEUX : NOMME, laisse en place, compte
     dans le rapport. Les quatre refus du contrat de rotation qui concernent le
     classement sont donc verifies AVANT de juger -- point plus recent que sa
     source, source absente, zone hors perimetre, point introuvable ;
  3. `--simuler oui` n'ecrit RIEN : ni BDD, ni disque. C'est le mode par lequel on
     verifie ce qu'on s'apprete a faire, et il doit rester le premier reflexe.

CE QUE LA PORTE NE FAIT PAS : elle ne deplace aucun fichier. L'acte appartient a
la porte de rotation (`archiver --lot oui`), qui exige une decision deja tracee.
Un balayage se juge donc sur ses DECISIONS, et l'archive sur son manifeste.
"""
from pathlib import Path

from archiver.fonctions import (
    hors_perimetre, motif_forme, origine_complete, points_sans_decision,
    suffixe_point,
)
from balayer.fonctions import (
    ordonner_familles, structurels_depasses, verdicts_de_famille,
)
from cible import resoudre
from commun import charger_bdd, enregistrer_bdd, extraire_options
from constants import (
    CHEMIN_DOMICILE_FORME_BAK, ECRIVAINS_FAMILLE_RESTAURATION,
    INDEX_FAMILLE_RESTAURATION, LECTEURS_FAMILLE_RESTAURATION,
    MOTIF_RECENSEMENT_FAMILLE, REPERTOIRE_ARCHIVES,
)
from ajouter.fonctions import (
    classer_entree, creer_entree, decider_entree, recenser_entrees,
    rejuger_entree,
)

NOMS_OPTIONS = ("simuler", "mission")
TAGS = "balayer,purification,bak,rotation,regle"
# Les statuts ou un classement est EN ROUTE (le contrat de `classer_entree` les
# accepte justement parce qu'une transition peut etre interrompue) : ce sont eux
# que la porte de l'acte ne reprend jamais, donc eux que le balayage doit fermer.
STATUTS_INACHEVES = ("propose", "classe")
DEPART = Path(__file__).resolve().parent


def _vrai(valeur):
    return str(valeur).strip().lower() in ("oui", "true", "1", "vrai")


def _points_sur_disque(donnees, motif):
    """Les points de restauration PRESENTS sur le disque : les CIBLES et les JUMEAUX.

    Le balayage a besoin de la FAMILLE ENTIERE pour savoir qui est remplace :
    `points_sans_decision` rend les cibles (absentes de la BDD), et la BDD rend
    les jumeaux DEJA juges dont la source existe encore. Sans ces jumeaux, un
    point seul de sa famille serait declare `STRUCTUREL` alors qu'un plus recent
    existe -- mesure MO-162 : le plus recent est celui du DISQUE, et un plus
    recent deja archiver ne compte plus, sa source ayant quitte sa place.
    """
    points = set(points_sans_decision(donnees, DEPART))
    for entree in donnees.get("elements", []):
        source = str(entree.get("source", "")).replace("\\", "/")
        if not source or not motif.search(source.split("/")[-1]):
            continue
        chemin, _ = resoudre(source, DEPART)
        if chemin is not None and chemin.is_file():
            points.add(source)
    return sorted(points)


def _classements_inacheves(donnees, motif):
    """Les elements de la famille DECLARES et jamais juges. Rend [(id, source)].

    C'est le TROU mesure a la fermeture d'EO-147 : `points_sans_decision` exclut
    les sources DEJA declarees, donc un element reste a `propose` (ou a `classe`)
    n'appartient plus a aucune des deux populations -- ni "sans decision" (il est
    dans la BDD), ni "juge" (il n'a pas de verdict). Ni l'acte ni le balayage ne le
    reprenaient. Un element ne doit pas pouvoir tomber entre les deux : c'est
    exactement par la qu'un travail se croit fini sans l'etre.

    L'ORDRE est celui de la BDD (identifiants croissants) : un element ancien
    repasse avant un recent, ce qui rend la reprise lisible dans le rapport.
    """
    inacheves = []
    for entree in donnees.get("elements", []):
        source = str(entree.get("source", "")).replace("\\", "/")
        if not source or entree.get("verdict"):
            continue
        if entree.get("statut") not in STATUTS_INACHEVES:
            continue
        if not motif.search(source.split("/")[-1]):
            continue
        inacheves.append((str(entree.get("id", "")), source))
    return inacheves


def _doute(relatif):
    """La raison de NE PAS juger ce point, ou "" s'il est jugeable.

    L'ordre suit le contrat de rotation : le POINT, le PERIMETRE, la SOURCE, la
    FRAICHEUR. Chaque raison est un FAIT mesure, jamais une supposition -- un
    doute muet serait un angle mort, et un doute devine serait un mensonge.
    """
    chemin, _ = resoudre(relatif, DEPART)
    if chemin is None or not chemin.is_file():
        return "point introuvable sur le disque"
    if hors_perimetre(chemin, DEPART):
        return "zone hors perimetre (hors Matrice, ou zone du voisin Flux 1)"
    origine, _ = resoudre(origine_complete(relatif), DEPART)
    if origine is None or not origine.is_file():
        return "source absente : le point serait le dernier chemin de restauration"
    if chemin.stat().st_mtime_ns > origine.stat().st_mtime_ns:
        return "point plus recent que sa source (seul temoin d'une ecriture en cours)"
    return ""


def _textes(relatif, verdict, plus_recent, rejuge=False):
    """(raison, preuve, destination) d'un verdict -- LES MOTS, jamais le verdict.

    Les TROIS chemins (point NEUF, element INACHEVE, STRUCTUREL DEPASSE) partagent
    ces mots : un element repris ou re-juge ne peut donc pas raconter autre chose
    qu'un element neuf, sinon le balayage aurait plusieurs verites selon la porte
    par laquelle on entre.

    `rejuge` ajoute UN fait, il ne change aucun verdict : ce point ETAIT le plus
    recent de sa famille et ne l'est plus. Sans ce mot, la preuve dirait "remplace"
    d'un point que la BDD disait "plus recent", et rien ne dirait POURQUOI la
    decision a change.
    """
    origine = origine_complete(relatif).split("/")[-1]
    if verdict == "conserver":
        raison = ("Point de restauration LE PLUS RECENT de " + origine + " : aucun plus "
                  "recent n'existe pour ce fichier, il sert au revert d'une modification "
                  "en cours (regle du plan MO-094 : garder les N plus recents par fichier).")
        preuve = ("regle de la famille (mesure MO-162) : aucun plus recent pour ce fichier "
                  "-- dernier temoin de " + origine + " avant sa version courante.")
        return raison, preuve, ""
    plus_recent_nom = plus_recent.replace("\\", "/").split("/")[-1]
    marque = ("RE-JUGE (EO-152) : ce point ETAIT le plus recent de sa famille ; un point "
              "plus recent l'a REMPLACE depuis, donc la regle du jour le dit OBSOLETE. "
              if rejuge else "")
    raison = marque + ("Point de restauration REMPLACE de " + origine + " : une version "
                       "plus recente existe pour ce fichier. Regle du plan MO-094 : garder "
                       "les N plus recents par fichier, archiver les versions depassees "
                       "(jamais de suppression seche).")
    preuve = marque + ("regle de la famille (mesure MO-162) : REMPLACE par "
                       + plus_recent_nom + ", qui reste EN PLACE -- ce point n'est plus "
                       "le temoin d'une ecriture en cours.")
    return raison, preuve, REPERTOIRE_ARCHIVES + "/" + relatif.replace("\\", "/")


def _decider(donnees, identifiant, categorie, verdict, raison, preuve, destination):
    """Les DEUX dernieres marches, dans l'ordre impose (`classer` puis `decider`).

    Elles sont communes aux deux chemins : un element neuf vient de naitre a
    `propose`, un element inacheve y est deja -- mais a partir d'ici, la route est
    la MEME, donc les transitions restent celles du proprietaire de la BDD.
    """
    entree, message = classer_entree(donnees, identifiant, categorie, raison)
    if entree is None:
        return identifiant, "classer refuse : " + message
    entree, message = decider_entree(donnees, identifiant, verdict, destination, preuve)
    if entree is None:
        return identifiant, "decider refuse : " + message
    return identifiant, ""


def _juger(donnees, relatif, categorie, verdict, plus_recent, mission):
    """LE PREMIER chemin : le point est NEUF -- les TROIS marches sont franchies."""
    raison, preuve, destination = _textes(relatif, verdict, plus_recent)
    entree, message = creer_entree(donnees, {
        "source": relatif, "categorie": categorie, "raison": raison,
        "tags": TAGS, "mission": mission,
    })
    if entree is None:
        return "", "proposer refuse : " + message
    return _decider(donnees, entree["id"], categorie, verdict, raison, preuve, destination)


def _reprendre(donnees, identifiant, relatif, categorie, verdict, plus_recent):
    """LE SECOND chemin : l'element EXISTE deja, son classement est INACHEVE.

    On ne le cree pas une seconde fois (deux entrees pour une meme source, c'est un
    doublon) : on reprend les DEUX dernieres marches. Et la categorie comme la
    raison sont RE-MESUREES par la regle d'AUJOURD'HUI -- un element bloque a ete
    classe sur une famille qui a change depuis (un point plus recent a pu naitre
    entre-temps). Recopier la categorie stockee ferait juger le passe avec les
    yeux du passe : la regle est celle du moment ou l'on juge.
    """
    raison, preuve, destination = _textes(relatif, verdict, plus_recent)
    return _decider(donnees, identifiant, categorie, verdict, raison, preuve, destination)


def _rejuger(donnees, identifiant, relatif, categorie, verdict, plus_recent):
    """LE TROISIEME chemin : le point etait DECIDE, un plus recent l'a REMPLACE.

    On ne le RECREE pas (il est deja dans la BDD) et on ne le REPREND pas comme un
    inacheve (il a un verdict) : on RE-OUVRE sa decision par la transition
    DECLAREE (`rejuger_entree`), puis on rejoue les deux dernieres marches. La
    transition ramene l'element a `classe` et VIDE son verdict : si le re-jugement
    est interrompu, l'element tombe dans la population INACHEVE et le balayage
    suivant le reprend -- un travail ne peut donc pas se perdre en chemin (c'est le
    trou ferme par EO-147, applique au re-jugement).
    """
    raison, preuve, destination = _textes(relatif, verdict, plus_recent, rejuge=True)
    entree, message = rejuger_entree(donnees, identifiant, raison)
    if entree is None:
        return identifiant, "rejuger refuse : " + message
    return _decider(donnees, identifiant, categorie, verdict, raison, preuve, destination)


def executer(arguments):
    options = extraire_options(arguments[1:], NOMS_OPTIONS)
    simuler = _vrai(options.get("simuler", ""))
    mission = options.get("mission", "")
    donnees = charger_bdd()

    motif = motif_forme()
    if motif is None:
        print("Refus : la forme du point de restauration est introuvable chez son "
              "proprietaire (" + str(CHEMIN_DOMICILE_FORME_BAK) + "). Le balayage ne "
              "DEVINE aucune forme : une forme redevinee derive en silence (L-100).")
        return 2

    cibles = [(relatif, "") for relatif in points_sans_decision(donnees, DEPART)]
    inacheves = _classements_inacheves(donnees, motif)

    # La 3e population exige les verdicts du JOUR : ils se calculent sur le DISQUE
    # (le plus recent est celui du disque -- un plus recent deja archive ne compte
    # plus, sa source ayant quitte sa place). Ils sont donc calcules AVANT de
    # decider qu'il n'y a rien a faire : sans cela le balayage rendrait "EN ORDRE"
    # en laissant des STRUCTUREL en trop, le FAUX POSITIF mesure par MO-164.
    sur_disque = _points_sur_disque(donnees, motif)
    verdicts = verdicts_de_famille(ordonner_familles(sur_disque))
    depasses = structurels_depasses(donnees.get("elements", []), motif, verdicts)

    juges = []
    doutes = []
    for relatif, identifiant in cibles + [(source, identifiant)
                                          for identifiant, source in inacheves]:
        raison = _doute(relatif)
        if raison:
            doutes.append((relatif, raison))
            continue
        categorie, verdict, plus_recent = verdicts.get(relatif, ("", "", ""))
        if not categorie:
            doutes.append((relatif, "famille non ordonnable par la regle"))
            continue
        repris = bool(identifiant)
        refus = ""
        if not simuler:
            if repris:
                identifiant, refus = _reprendre(donnees, identifiant, relatif, categorie,
                                                verdict, plus_recent)
            else:
                identifiant, refus = _juger(donnees, relatif, categorie, verdict,
                                            plus_recent, mission)
        if refus:
            doutes.append((relatif, refus))
            continue
        juges.append((relatif, categorie, verdict, identifiant,
                      "REPRIS " if repris else ""))

    for identifiant, relatif, plus_recent in depasses:
        raison = _doute(relatif)
        if raison:
            doutes.append((relatif, raison))
            continue
        categorie, verdict, _ = verdicts.get(relatif, ("", "", ""))
        if not categorie:
            doutes.append((relatif, "famille non ordonnable par la regle"))
            continue
        refus = ""
        if not simuler:
            identifiant, refus = _rejuger(donnees, identifiant, relatif, categorie,
                                          verdict, plus_recent)
        if refus:
            doutes.append((relatif, refus))
            continue
        juges.append((relatif, categorie, verdict, identifiant, "REJUGE "))

    # RECENSEMENT DE LA FAMILLE (MO-306) : le balayage COMPLETE ce qu'il cree.
    # Le plan (plan-conservation, section 5) impose a la rotation de REFUSER un
    # element sans lecteur recense ; or le balayage ecrivait ses entrees SANS les
    # trois champs de recensement -- leurs colonnes restaient VIDES et l'acte etait
    # refuse POUR TOUJOURS (mesure du 2026-09-20 : 430 elements bloques pour ce seul
    # motif, la famille jugee ne pouvait jamais quitter sa place). La mesure vit au
    # DOMICILE (constants) et n'est jamais recopiee ici (M-076) ; le verbe du
    # proprietaire de la BDD l'ecrit (ajouter.recenser_entrees) et il est IDEMPOTENT
    # (il n'ecrit que ce qui change, aucun statut ni verdict touche).
    recenses = 0
    if not simuler:
        recenses, _message_recensement = recenser_entrees(
            donnees, suffixe_point() or "",
            LECTEURS_FAMILLE_RESTAURATION, ECRIVAINS_FAMILLE_RESTAURATION,
            INDEX_FAMILLE_RESTAURATION, MOTIF_RECENSEMENT_FAMILLE)

    if not cibles and not inacheves and not depasses and not recenses:
        print("BALAYAGE : la famille de rotation est EN ORDRE -- aucun point sans "
              "decision, aucun classement inacheve, aucun STRUCTUREL depasse, "
              "aucune entree a recenser.")
        return 0

    print("BALAYAGE de la famille de rotation" + (" (SIMULATION)" if simuler else ""))
    print("  points sans decision      : " + str(len(cibles)))
    print("  classements inacheves     : " + str(len(inacheves)))
    print("  STRUCTUREL depasses       : " + str(len(depasses)))
    print("  juges par la regle        : " + str(len(juges)))
    print("  laisses en place          : " + str(len(doutes)) + " (douteux)")
    print("  entree(s) recensee(s)     : " + str(recenses))
    print("")
    for relatif, categorie, verdict, identifiant, marque in juges:
        numero = (identifiant + " ") if identifiant else ""
        print("  " + numero + marque + categorie + " -> " + verdict + "  " + relatif)
    if doutes:
        print("")
        print("DOUTEUX (la regle ne les couvre pas : laisses EN PLACE, aucun verdict) :")
        for relatif, raison in doutes:
            print("  " + relatif)
            print("      -> " + raison)

    if simuler:
        print("")
        print("SIMULATION : aucune ecriture (ni BDD, ni disque).")
        return 0
    if juges or recenses:
        empreinte = enregistrer_bdd(donnees)
        print("")
        print("BDD de conservation enregistree : " + str(len(juges)) + " element(s) juge(s), "
              + str(recenses) + " recense(s) -- empreinte : " + empreinte[:16] + "...")
        a_archiver = sum(1 for _, _, verdict, _, _ in juges if verdict == "archiver")
        if a_archiver:
            print("L'acte reste a la porte de rotation : " + str(a_archiver)
                  + " element(s) a archiver (python main.py archiver --lot oui).")
    return 0
