"""Entree du verbe benchmark : 9 epreuves par fichier."""
import sys
import os

# L-013 : aucun niveau compte a la main. Le dossier de CET outil est celui qui
# porte son commun.py (marqueur) : la remontee est VERIFIEE, jamais supposee (MO-177).
REPERTOIRE_ENTREE = os.path.dirname(os.path.abspath(__file__))
REPERTOIRE_OUTIL = os.path.dirname(REPERTOIRE_ENTREE)
if not os.path.isfile(os.path.join(REPERTOIRE_OUTIL, "commun.py")):
    raise RuntimeError("Dossier de l'outil introuvable depuis " + REPERTOIRE_ENTREE
                       + " : commun.py est absent de " + REPERTOIRE_OUTIL)
sys.path.insert(0, REPERTOIRE_OUTIL)

from commun import (
    ancrer,
    lancer_9_epreuves,
    lister_fichiers,
    extraire_options,
    signaler_inconnues,
)
from constants import NOMS_OPTIONS_BENCHMARK


def benchmark(arguments):
    """Verbe benchmark : --fichier <chemin> | --dossier <chemin> | --integration [--json]
    
    Codes retour :
      0 = toutes epreuves passees
      1 = au moins 1 echec
      2 = refus (perimetre)
    """
    options = extraire_options(arguments, NOMS_OPTIONS_BENCHMARK)

    mode_json = "json" in options

    # Mode integration
    if "integration" in options:
        return _benchmark_integration(options, mode_json)

    # Mode dossier (batch)
    if "dossier" in options:
        return _benchmark_dossier(options, mode_json)

    # Mode fichier unique
    if "fichier" in options:
        return _benchmark_fichier(options["fichier"], options, mode_json)

    print("ERREUR : --fichier, --dossier, ou --integration requis.")
    print("Usage : benchmark --fichier <chemin> [--json]")
    print("        benchmark --dossier <chemin> [--recursif] [--filtre] [--json]")
    print("        benchmark --integration [--json]")
    return 2


def _benchmark_fichier(chemin, options, mode_json):
    """Benchmark d'un seul fichier."""
    # MO-186 : le chemin est ancre UNE fois (domicile cible.resoudre) AVANT tout
    # jugement et avant les 9 epreuves -- le chemin juge est le chemin LU, et le
    # verdict ne depend plus de QUI lance (friction 80). La variable morte
    # `attendu` (declaree dans l'aide, jamais lue) est retiree au passage.
    # MO-195 (EO-180) : l'OPTION elle-meme disparait du contrat -- elle etait
    # declaree dans NOMS_OPTIONS_BENCHMARK et dans l'aide, et personne ne
    # l'appelait (mesure : `--attendu existe` rendait 0 et 9/9 VERT, comme sans
    # elle). Une option declaree qui n'agit pas se lit comme un fait : le mode
    # "attendu" se DECIDERA dans une mission a lui, s'il devient necessaire.
    chemin_ancre, motif = ancrer(chemin, REPERTOIRE_ENTREE)
    if chemin_ancre is None:
        print("REFUS : " + motif)
        return 2
    chemin = str(chemin_ancre)
    
    resultats, code = lancer_9_epreuves(chemin)

    if mode_json:
        import json
        sortie = {
            "fichier": chemin,
            "epreuves": resultats,
            "total": len(resultats),
            "passees": sum(1 for r in resultats if r["passe"]),
            "code": code,
        }
        print(json.dumps(sortie, ensure_ascii=False, indent=2))
    else:
        nb_passees = sum(1 for r in resultats if r["passe"])
        print(f"BENCHMARK : {chemin}")
        print(f"Resultat : {nb_passees}/9 epreuves | Code : {code}")
        print("")
        for r in resultats:
            statut = "VERT" if r["passe"] else "ROUGE"
            print(f"  {statut} {r['nom']:15s} {r['detail']}")
        print("")
        if code == 0:
            print("BILAN : 9/9 VERT")
        else:
            print(f"BILAN : {nb_passees}/9 VERT, {9 - nb_passees} ROUGE")

    return code


def _benchmark_dossier(options, mode_json):
    """Benchmark batch d'un dossier."""
    # MO-186 : meme ancrage UNIQUE que --fichier, par le domicile partage.
    dossier_ancre, motif = ancrer(options["dossier"], REPERTOIRE_ENTREE)
    if dossier_ancre is None:
        print("REFUS : " + motif)
        return 2
    dossier = str(dossier_ancre)
    recursif = "recursif" in options
    filtre = options.get("filtre", None)

    fichiers = lister_fichiers(dossier, recursif=recursif, filtre=filtre)

    if not fichiers:
        print("Aucun fichier trouve dans " + dossier)
        return 1

    resultats_batch = []
    code_global = 0

    for fp in fichiers:
        resultats, code = lancer_9_epreuves(str(fp))
        resultats_batch.append({
            "fichier": str(fp),
            "resultats": resultats,
            "code": code,
        })
        if code == 2:
            code_global = 2
        elif code == 1 and code_global == 0:
            code_global = 1

    nb_total = len(resultats_batch)
    nb_ok = sum(1 for r in resultats_batch if r["code"] == 0)

    if mode_json:
        import json
        sortie = {
            "dossier": dossier,
            "recursif": recursif,
            "filtre": filtre,
            "total": nb_total,
            "ok": nb_ok,
            "echecs": nb_total - nb_ok,
            "code": code_global,
            "fichiers": resultats_batch,
        }
        print(json.dumps(sortie, ensure_ascii=False, indent=2))
    else:
        print(f"BENCHMARK BATCH : {dossier}")
        print(f"Fichiers : {nb_total} | OK : {nb_ok} | Echecs : {nb_total - nb_ok}")
        print("")
        for r in resultats_batch:
            nb_passees = sum(1 for e in r["resultats"] if e["passe"])
            statut = "VERT" if r["code"] == 0 else "ROUGE"
            print(f"  {statut} {r['fichier']} ({nb_passees}/9)")

    return code_global


def _benchmark_integration(options, mode_json):
    """Benchmark d'integration : croise tous les outils."""
    from pathlib import Path
    
    # List of tools to test cross-cutting
    outils = ["lire", "ecrire", "lister", "rechercher", "executer", "dialoguer", "benchmark"]
    resultats = []

    for outil in outils:
        dossier = Path(__file__).parent.parent.parent / outil
        if dossier.is_dir():
            for py in dossier.rglob("*.py"):
                if "__pycache__" in py.parts:
                    continue
                res, code = lancer_9_epreuves(str(py))
                nb_passees = sum(1 for r in res if r["passe"])
                resultats.append({
                    "outil": outil,
                    "fichier": str(py),
                    "epreuves_ok": nb_passees,
                    "code": code,
                })

    nb_total = len(resultats)
    nb_ok = sum(1 for r in resultats if r["code"] == 0)
    total_epreuves = nb_total * 9
    ok_epreuves = sum(r["epreuves_ok"] for r in resultats)

    if mode_json:
        import json
        sortie = {
            "type": "integration",
            "outils": outils,
            "total_fichiers": nb_total,
            "ok_fichiers": nb_ok,
            "total_epreuves": total_epreuves,
            "ok_epreuves": ok_epreuves,
            "code": 0 if nb_ok == nb_total else 1,
            "details": resultats,
        }
        print(json.dumps(sortie, ensure_ascii=False, indent=2))
    else:
        print("BENCHMARK INTEGRATION")
        print(f"Outils testes : {len(outils)}")
        print(f"Fichiers : {nb_total} | OK : {nb_ok} | Echecs : {nb_total - nb_ok}")
        print(f"Epreuves : {ok_epreuves}/{total_epreuves}")
        print("")
        for r in resultats:
            statut = "VERT" if r["code"] == 0 else "ROUGE"
            print(f"  {statut} [{r['outil']}] {r['fichier']} ({r['epreuves_ok']}/9)")

    return 0 if nb_ok == nb_total else 1
