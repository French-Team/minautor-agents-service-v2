#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# sc-004-auto-diagnostic -- super-combo numerote sc-004
# Genere par creer-combo.py le 2026-09-19, implementation par MO-202.
#
# Auto-diagnostic des outils : (1) AGREGER les defauts DECLARES par les missions
# (R5, champ `defauts`) ; (2) SONDER chaque outil (une option inconnue doit etre
# REFUSEE, jamais avalee en silence) ; (3) PREPARER les missions de reparation en
# deposant les items a l entonnoir par SA porte.
#
# Regle : ce super-combo DIAGNOSTIQUE et PREPARE, il ne REPARE jamais lui-meme.
#
# Usage :
#     python main.py diagnostic [--fiche <json>]
#     python main.py inspection [--outils <dossier>] [--limite N]
#     python main.py preparer [--simuler] [--fiche <json>] [--outils <dossier>]
#     python main.py status
#     python main.py auto-test

import argparse
import json
import subprocess
import sys
from pathlib import Path

SUPER_ID = "sc-004"
SUPER_NOM = "sc-004-auto-diagnostic"
PHASES = ["diagnostic", "inspection", "preparer"]
VERBES = ["diagnostic", "inspection", "preparer", "status", "auto-test"]
VERBE_DEFAUT = "diagnostic"

# Le champ R5 et le statut de reparation : consommes du DOMICILE du pilote quand
# il est joignable, jamais recopies (une liste recopiee diverge en silence, L-035).
CHAMPS_DEFAUTS = ("outil", "defaut", "reproduit", "reparation", "preuve", "statut")
STATUT_DEFAUT_REPARE = "repare"
# La sonde : une option qui n existe nulle part doit provoquer un REFUS NOMME.
OPTION_BIDON = "--option-bidon-mo202"
MARQUEUR_REFUS = "OPTION INCONNUE"

CODE_OK = 0
CODE_ECHEC = 1
CODE_DIAGNOSTIC_NON_VIDE = 1

BORNES_REMONTEE = 30
REPERTOIRE_SUPER = Path(__file__).resolve().parent
_courant = REPERTOIRE_SUPER
for _ in range(BORNES_REMONTEE):
    if (_courant / "matrice" / "data" / "commun" / "racine.py").is_file():
        break
    _courant = _courant.parent
else:
    raise RuntimeError("Racine matrix/ introuvable en remontant.")
RACINE_MATRICE = _courant

DOSSIER_OUTILS = RACINE_MATRICE / "data" / "outils"
DOSSIER_PILOTE = RACINE_MATRICE / "_operateur" / "optimus-prime" / "pilote"
FICHE_MISSIONS = DOSSIER_PILOTE / "file-missions-optimus.json"
JOURNAL_MISSIONS = RACINE_MATRICE / "data" / "historiques-missions-optimus.jsonl"
PORTE_ENTONNOIR = DOSSIER_PILOTE / "entonnoir" / "main.py"


def lire_json(chemin):
    # Lire un JSON ; une absence est DITE par l appelant, jamais devinee.
    if not chemin.is_file():
        return None
    with open(chemin, "r", encoding="utf-8") as fichier:
        return json.load(fichier)


def lancer_outil(chemin, arguments):
    # Lancer un outil de la Matrice : (code, sortie) ; un outil absent ne casse rien.
    if not chemin.is_file():
        return 127, "outil introuvable : " + str(chemin)
    resultat = subprocess.run(
        [sys.executable, str(chemin)] + arguments,
        capture_output=True, text=True,
    )
    return resultat.returncode, (resultat.stdout or "") + (resultat.stderr or "")


def lire_lignes_jsonl(chemin):
    # Lire un JSONL en AJOUT SEUL ; une ligne illisible est SIGNALEE, jamais sautee.
    if not chemin.is_file():
        return [], "journal absent : " + str(chemin)
    objets = []
    for numero, ligne in enumerate(chemin.read_text(encoding="utf-8").splitlines(), 1):
        if not ligne.strip():
            continue
        try:
            objets.append(json.loads(ligne))
        except json.JSONDecodeError:
            return objets, "ligne " + str(numero) + " illisible : ignoree"
    return objets, ""


def defauts_declares(fiche, journal):
    # Collecter les defauts DECLARES (R5) : la FICHE des missions d abord, puis le
    # JOURNAL (un defaut historise reste un fait, meme si la mission a quitte la fiche).
    trouves = []
    for mission in fiche.get("missions", []):
        for defaut in mission.get("defauts") or []:
            trouves.append((mission.get("id", "?"), defaut))
    objets, ecart = lire_lignes_jsonl(journal)
    for objet in objets:
        for defaut in objet.get("defauts") or []:
            trouves.append((objet.get("id", "?"), defaut))
    return trouves, ecart


def defauts_ouverts(trouves):
    # Un defaut OUVERT : son statut n est pas `repare`. Un statut VIDE n est pas
    # cache : il est compte ouvert (une colonne vide se lit comme un fait).
    return [(mission, defaut) for mission, defaut in trouves
            if (defaut.get("statut") or "") != STATUT_DEFAUT_REPARE]


def grouper_par_outil(ouverts):
    # Agreger par OUTIL : le diagnostic se lit par outil, jamais mission par mission.
    par_outil = {}
    for mission, defaut in ouverts:
        outil = defaut.get("outil") or "(sans outil)"
        entree = par_outil.setdefault(outil, {"defauts": [], "missions": []})
        entree["defauts"].append(defaut.get("defaut") or "(sans texte)")
        if mission not in entree["missions"]:
            entree["missions"].append(mission)
    return par_outil


def cmd_diagnostic(arguments):
    # Phase 1 : AGREGER les defauts declares par les missions (matiere premiere R5).
    parser = argparse.ArgumentParser(description="Agreger les defauts R5 declares")
    parser.add_argument("--fiche", default=None, help="Fiche des missions (cobaye)")
    parser.add_argument("--journal", default=None, help="Journal JSONL (cobaye)")
    parsed = parser.parse_args(arguments)
    fiche = lire_json(Path(parsed.fiche) if parsed.fiche else FICHE_MISSIONS)
    if fiche is None:
        print("DIAGNOSTIC : fiche des missions illisible : " + str(FICHE_MISSIONS))
        return CODE_ECHEC
    journal = Path(parsed.journal) if parsed.journal else JOURNAL_MISSIONS
    trouves, ecart = defauts_declares(fiche, journal)
    if ecart:
        print("DIAGNOSTIC : " + ecart)
    ouverts = defauts_ouverts(trouves)
    par_outil = grouper_par_outil(ouverts)
    print("DIAGNOSTIC DES OUTILS (defauts declares R5)")
    print("  defauts lus : " + str(len(trouves)) + " | ouverts : " + str(len(ouverts))
          + " | repares : " + str(len(trouves) - len(ouverts)))
    if not par_outil:
        print("  AUCUN defaut ouvert : rien a preparer.")
        return CODE_OK
    for outil in sorted(par_outil):
        entree = par_outil[outil]
        print("  " + outil + " (" + str(len(entree["defauts"])) + " defaut(s), missions "
              + ", ".join(entree["missions"]) + ")")
        for texte in entree["defauts"]:
            print("    - " + texte)
    return CODE_DIAGNOSTIC_NON_VIDE


def outils_du_dossier(dossier):
    # Les outils de la Matrice : un dossier = un outil, avec SON main.py.
    outils = []
    if not dossier.is_dir():
        return outils
    for entree in sorted(dossier.iterdir()):
        if entree.is_dir() and (entree / "main.py").is_file():
            outils.append((entree.name, entree / "main.py"))
    return outils


def sonder(main):
    # SONDER un outil : une option inconnue doit etre REFUSEE et NOMMEE. Un code 0
    # signifie que l appel a rendu le resultat du DEFAUT, indiscernable d un
    # resultat correct (EO-179, L-055) : c est un ecart, pas un silence a ignorer.
    code, sortie = lancer_outil(main, [OPTION_BIDON, "1"])
    if code == 127:
        return "injoignable", sortie
    if code == 0:
        return "avale", "code 0 au lieu d un refus : l option inconnue est ignoree"
    if MARQUEUR_REFUS in sortie:
        return "refuse", ""
    return "refus-muet", "code " + str(code) + " mais le refus ne NOMME pas l option inconnue"


def cmd_inspection(arguments):
    # Phase 2 : SONDER les outils (l angle mort qu aucune mission ne declare).
    parser = argparse.ArgumentParser(description="Sonder les outils de la Matrice")
    parser.add_argument("--outils", default=None, help="Dossier des outils (cobaye)")
    parser.add_argument("--limite", type=int, default=0, help="Limiter le nombre d outils sondes")
    parsed = parser.parse_args(arguments)
    dossier = Path(parsed.outils) if parsed.outils else DOSSIER_OUTILS
    outils = outils_du_dossier(dossier)
    if not outils:
        print("INSPECTION : aucun outil trouve dans " + str(dossier))
        return CODE_ECHEC
    if parsed.limite:
        outils = outils[:parsed.limite]
    ecarts = []
    print("INSPECTION DES OUTILS (sonde " + OPTION_BIDON + " : refus directionnel attendu)")
    for nom, main in outils:
        etat, detail = sonder(main)
        if etat == "refuse":
            continue
        ecarts.append((nom, etat, detail))
        print("  [" + etat + "] " + nom + " : " + detail)
    print("  sondes : " + str(len(outils)) + " | conformes : " + str(len(outils) - len(ecarts))
          + " | ecarts : " + str(len(ecarts)))
    return CODE_DIAGNOSTIC_NON_VIDE if ecarts else CODE_OK
