def verifier_serie_stricte(file_missions):
    """Garde-fou : verifie avant injection qu'aucun doublon ni anomalie n'existe.

    Verifications :
    1. Pas de mission en cours (serie stricte)
    2. Pas de doublon de theme+objectif dans la file
    3. Pas de mission terminee re-injectable
    Retourne (code, message). code 0 = OK.
    """
    # 1. Serie stricte
    encours = mission_en_cours(file_missions)
    if encours is not None:
        return 1, "REFUS : mission en cours (" + encours["id"] + "). Serie stricte."

    # 2. Doublons
    missions = file_missions.get("missions", [])
    vues = set()
    for m in missions:
        if m.get("statut") != STATUT_EN_ATTENTE:
            continue
        cle = (m.get("theme", ""), m.get("objectif", ""))
        if cle in vues:
            return 1, "REFUS : doublon detecte (" + cle[0] + ")."
        vues.add(cle)

    return 0, "Serie stricte OK"
