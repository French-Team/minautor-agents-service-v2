def verification_post_fin(mission, bilan):
    """Verification automatique apres chaque fin de mission.

    Le pilote lance :
    1. py_compile sur les .py modifies (si mentionnes dans le bilan)
    2. benchmark --fichier sur les outils modifies
    3. verification ASCII
    Retourne (code, messages).
    """
    messages = []
    code_global = 0

    # Extrait les chemins .py du bilan (pattern: data/outils/XXX/ ou chemin relatif)
    import re
    chemins_py = re.findall(r"data/outils/[\w-]+/\w+\.py", bilan)
    # Aussi les chemins absolus ou relatifs mentionnes
    chemins_py += re.findall(r"_operateur/[\w/]+\.py", bilan)

    if not chemins_py:
        return 0, []

    # py_compile rapide sur les .py detectes
    for chemin in set(chemins_py):
        # Essai direct (data/outils/...) puis avec matrice/ prefixe
        plein = REPERTOIRE_MATRIX / chemin
        if not plein.is_file():
            plein = REPERTOIRE_MATRIX / "matrice" / chemin
        if plein.is_file():
            try:
                result = subprocess.run(
                    [sys.executable, "-m", "py_compile", str(plein)],
                    capture_output=True, timeout=10,
                    creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
                )
                if result.returncode != 0:
                    messages.append("[POST-FIN] py_compile FAIL: " + chemin)
                    code_global = 1
                else:
                    messages.append("[POST-FIN] py_compile OK: " + chemin)
            except (subprocess.TimeoutExpired, OSError):
                pass

    return code_global, messages


def nettoyer_intercom():
    """Nettoie les messages traites de l'intercom maintenance.

    Supprime les lignes avec traite_par_optimus=true de la boite maintenance.
    Append-only respecte : on ecrit un nouveau fichier sans les traites.
    """
    boite_in = REPERTOIRE_INTERCOM / "matrice" / "inbox.jsonl"
    if not boite_in.is_file():
        return 0

    lignes = boite_in.read_text(encoding=ENCODAGE, errors="replace").splitlines()
    nettoyes = 0
    gardes = []

    for ligne in lignes:
        ligne = ligne.strip()
        if not ligne:
            continue
        try:
            msg = json.loads(ligne)
            if msg.get("traite_par_optimus"):
                nettoyes += 1
            else:
                gardes.append(ligne)
        except json.JSONDecodeError:
            gardes.append(ligne)

    if nettoyes > 0:
        boite_tmp = boite_in.with_suffix(".jsonl.tmp")
        with open(boite_tmp, "w", encoding=ENCODAGE, newline="\n") as f:
            for g in gardes:
                f.write(g + "\n")
        os.replace(boite_tmp, boite_in)
        print("[NETTOYAGE] " + str(nettoyes) + " messages traites purges de maintenance.")

    return nettoyes


def purger_zone_temporaire(mission):
    """Vide la zone jetable d'Optimus et NOTE la suppression au marbre (MO-136).

    Le point 4 de la regle immuable `perimetre-tmp` ("en fin de mission, le
    CONTENU de la zone est VIDE ; sa suppression se TRACE, jamais silencieuse")
