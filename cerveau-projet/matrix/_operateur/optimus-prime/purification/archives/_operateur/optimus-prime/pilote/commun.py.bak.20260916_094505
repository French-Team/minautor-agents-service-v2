def lire_etat_session():
    """L'ETAT de session, LU par sa porte (lecture bornee, MO-121).

    Une seule question, une seule reponse : le pilote doit SAVOIR s'il ouvre
    une session ou s'il la double. Le vocabulaire du format est PARTAGE
    (data/commun/trace_session.py) : celui qui AFFICHE et celui qui LIT
    consomment la meme constante, ils ne la recopient pas (friction 41).
    Retourne (code, etat) -- non bloquant.
    """
    commande = [sys.executable, str(CHEMIN_PORTE_SESSIONS), "etat"]
    try:
        resultat = subprocess.run(
            commande, capture_output=True, timeout=15,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
            env={**os.environ, "PYTHONIOENCODING": "utf-8"},
        )
    except (subprocess.TimeoutExpired, OSError) as erreur:
        return 1, "porte bdd-sessions injoignable : " + str(erreur)
    sortie = (resultat.stdout or resultat.stderr).decode(ENCODAGE, errors="replace")
    sortie = sortie.encode("ascii", errors="ignore").decode("ascii").strip()
    if resultat.returncode != 0 or MARQUEUR_ETAT not in sortie:
        return 1, "etat de session illisible : " + sortie[:120]
    return 0, sortie.split(MARQUEUR_ETAT, 1)[1].strip().splitlines()[0].strip()


def ouvrir_session():
    """OUVRE la session courante dans la BDD sessions (porte unique, MO-121).

    ECRIT : la porte `ajouter` accepte le tag `session-ouverte` depuis MO-092,
    mais AUCUN appelant ne le posait -- la trace automatique du pilote (tag
    `travail`) restait invisible de la reprise, qui ne lit que les tags de
    session (friction 41). Le pilote OUVRE donc la session au demarrage du
    cycle, et JAMAIS deux fois : l'etat est LU par la porte AVANT toute
    ecriture (une ouverture deja posee n'est pas doublee).

    La FERMETURE reste un acte de l'agent (proto-1 ETAPE 5) : un demarrage ne
    peut pas prouver qu'une session est finie.
    Retourne (code, sortie) -- non bloquant (comme noter_session).
    """
    code, etat = lire_etat_session()
    if code != 0:
        return code, etat
    if etat == ETAT_OUVERTE:
        return 0, "session deja ouverte : rien a doubler."
    return noter_session(
        TAG_SESSION_OUVERTE,
        "Session OUVERTE au demarrage du cycle (pilote, MO-121).",
        mission="",
    )


