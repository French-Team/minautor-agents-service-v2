PLAFOND_MISSIONS_ACTIVES = 50


def archiver_anciennes_missions(file_missions):
    """Archive les missions terminees au-dela du plafond (50 max en actif).

    Les missions archivees sont DEPLACEES dans file-missions-optimus-archive.json.
    Garde MO-091 (2026-09-14) : le DEPLACEMENT est complet, sinon la memoire dit
    une chose et le disque en dit une autre.
    (1) La file ACTIVE est persistee ICI (tmp + remplacement atomique, LF) --
    muter la liste en memoire ne suffit pas (preuve : 68 terminees restees sur
    disque, l'archivage par la porte fin n'ayant pas tourne).
    (2) DEDUP par id : un id deja present dans l'archive n'y rentre JAMAIS deux
    fois (premier evenement fait foi, L-040 transpose) et QUITTE l'actif --
    un id vit soit en actif, soit en archive, jamais les deux (preuve :
    42 entrees pour 28 ids, 14 jumeaux, MO-023..MO-028 dans les deux fichiers).
    (3) IDEMPOTENT : rejouer n'ecrit rien (retourne 0).
    Retourne le nombre de missions archivees.
    """
    missions = file_missions.get("missions", [])
    terminees = [m for m in missions if m.get("statut") == STATUT_TERMINEE]
    autres = [m for m in missions if m.get("statut") != STATUT_TERMINEE]

    if len(terminees) <= PLAFOND_MISSIONS_ACTIVES:
        return 0

    a_garder = terminees[-PLAFOND_MISSIONS_ACTIVES:]
    candidats = terminees[:-PLAFOND_MISSIONS_ACTIVES]

    chemin_archive = CHEMIN_FILE.with_name(NOM_FILE.replace(".json", "") + "-archive.json")
    if chemin_archive.exists():
        with open(chemin_archive, "r", encoding=ENCODAGE) as flux:
            archive_data = json.load(flux)
    else:
        archive_data = {"missions": []}

    deja_archivees = {m.get("id") for m in archive_data.get("missions", [])}
    a_archiver = [m for m in candidats if m.get("id") not in deja_archivees]
    # Invariant complet : un id deja archive est EVICTE de l'actif ou qu'il y
    # traine (double presence a reparer), pas seulement s'il est candidat.
    ids_sortants = {m.get("id") for m in candidats} | deja_archivees

    if a_archiver:
        archive_data["missions"].extend(a_archiver)
        archive_data["archive_le"] = horodater()

        chemin_tmp = chemin_archive.with_name(chemin_archive.name + ".tmp")
        with open(chemin_tmp, "w", encoding=ENCODAGE, newline="\n") as flux:
            json.dump(archive_data, flux, indent=INDENTATION_JSON, ensure_ascii=True)
            flux.write("\n")
        os.replace(chemin_tmp, chemin_archive)

    # Tous les ids sortants QUITTENT l'actif : nouveaux candidats (vers
    # l'archive) + deja-archivees (double presence a reparer).
    file_missions["missions"] = [m for m in missions if m.get("id") not in ids_sortants]
    if a_archiver or len(ids_sortants) > len(candidats):
        enregistrer_file(file_missions)
    return len(a_archiver)


def ids_en_lot(file_missions):
    """Retourne la liste des ids du lot actif (liste vide si pas de lot)."""
    lot = file_missions.get("lot")
    if not lot:
        return []
    return list(lot.get("ids", []))


def portee_lot(file_missions):
    """Retourne (ids_du_lot, position_k, total_n) pour la mission EN COURS.

    Serie stricte : au maximum une mission en cours ; si elle fait partie du
    lot actif, sa position est k dans le lot (k commence a 1).
    Retourne (None, 0, 0) si pas de lot ou mission hors lot.
    """
    ids = ids_en_lot(file_missions)
    if not ids:
        return (None, 0, 0)
    en_cours = mission_en_cours(file_missions)
    if en_cours is None or en_cours["id"] not in ids:
        return (None, 0, 0)
    return (ids, ids.index(en_cours["id"]) + 1, len(ids))


