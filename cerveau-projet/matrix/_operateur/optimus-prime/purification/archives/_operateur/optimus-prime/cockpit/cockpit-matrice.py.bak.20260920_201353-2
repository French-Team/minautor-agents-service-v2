        out.append(f"\n[{label}] code={code}\n" + body)
    for cmd, label in [
        ([sys.executable, str(REPERTOIRE_OP / "super-combos" / "combos" / "outils" / "garde-ascii.py"), str(REPERTOIRE_MATRIX)], "garde-ascii matrix/ (matrice + _operateur + docs)"),
