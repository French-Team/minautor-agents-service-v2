def resoudre_racine(valeur):
    """Racine du controle : valeur fournie, sinon la racine matrix/ detectee."""
    return Path(valeur).resolve() if valeur else RACINE_MATRICE


def afficher(titre, ecarts, dettes, exemptions=()):
    """Afficher un controle : ecarts bloquants, dette, puis EXEMPTIONS visibles.

    Une exemption n'est pas une dette : elle ne se rembourse pas. Elle se DIT,
    sinon personne ne sait ce que le controle a choisi de ne pas regarder.
    """
    print("--- " + titre + " ---")
    if not ecarts and not dettes and not exemptions:
        print("OK : aucun ecart.")
        return
    for ecart in ecarts:
        print("  ECART : " + ecart)
    for dette in dettes:
        print("  DETTE : " + dette)
    for exemption in exemptions:
        print("  EXEMPTE : " + exemption)


def principal(arguments):
    parser = argparse.ArgumentParser(description="Verifier le contrat fondamental CV-007")
    parser.add_argument("verbe", choices=("chemins", "noms", "flags", "collisions", "imports",
                                          "resolution", "insertions", "prefixes",
                                          "prefixes-en-dur", "jumeaux", "crochets", "appels-non-lies", "tout"))
    parser.add_argument("--racine", default=None, help="Racine a controler (defaut : matrix/)")
    parser.add_argument("--strict", action="store_true",
                        help="Rendre les dettes (parents[N]) bloquantes")
    parser.add_argument("--perimetre", default=None,
                        help="Perimetre(s) MIGRE(s), separes par des virgules : la ou le "
                             "garde est BLOQUANT (defaut : la declaration PERIMETRE_MIGRE)")
    options = parser.parse_args(arguments)

    verbe = options.verbe
    racine = resoudre_racine(options.racine)
    if not racine.is_dir():
        print("Racine introuvable : " + str(racine))
        return 2

    print("CONTRAT FONDAMENTAL CV-007 -- racine : " + str(racine))
    verbes = tuple(CONTROLES) if verbe == "tout" else (verbe,)

    total_ecarts = 0
    total_dettes = 0
    total_exemptions = 0
    perimetres = options.perimetre.split(",") if options.perimetre else None
    for nom in verbes:
        if nom == "chemins":
            resultat = controler_chemins(racine, options.strict)
        elif nom in VERBES_PERIMETRE:
            resultat = CONTROLES[nom](racine, perimetres)
        else:
            resultat = CONTROLES[nom](racine)
        # Un controle peut rendre une TROISIEME liste (les exemptions) : on ne
        # la devine pas, on la LIT quand elle est la (les autres verbes rendent
        # deux elements, leur contrat ne change pas).
        ecarts, dettes = resultat[0], resultat[1]
        exemptions = resultat[2] if len(resultat) > 2 else ()
        afficher(nom.upper(), ecarts, dettes, exemptions)
        total_ecarts += len(ecarts)
        total_dettes += len(dettes)
        total_exemptions += len(exemptions)

    print("")
    print("RESULTAT : " + str(total_ecarts) + " ecart(s), " + str(total_dettes) + " dette(s)"
          + ", " + str(total_exemptions) + " exemption(s) VISIBLE(s)")
    return 0 if total_ecarts == 0 else 1


if __name__ == "__main__":
    sys.exit(principal(sys.argv[1:]))
