def zone_operateur():
    """La zone de CE garde (le dossier `optimus-prime` qui le porte), ou None.

    Elle sert a BORNER la nouvelle regle : elle est BLOQUANTE dans la zone (c est
    notre code, on le repare) et CHIFFREE ailleurs (les outils de `matrice/data/`
    demandent chacun leur ancrage -- dette DITE, jamais muette).
    """
    for parent in Path(__file__).resolve().parents:
        if parent.name == "optimus-prime":
            return parent
    return None


def controler_chemins(racine, strict):
    """Ecarts de chemins : cwd interdit, niveaux COMPTES a la main (dette).

    Deux formes du meme peche (L-013) sont vues : `parents[N]` nu et une CHAINE
    de deux niveaux `dirname` -- toutes deux bloquees en mode `--strict`. La
    chaine `.parent` est de la meme famille mais sa classe est large : elle est
    CHIFFREE et DITE, non bloquante, tant que chaque site n a pas son ancrage.
    """
    ecarts = []
    dettes = []
    # Classe MESUREE (2026-09-18) : 32 sites de chaine `.parent`, tous ancrables un
    # par un -- mais chacun demande son marqueur. Elle est donc CHIFFREE et DITE ici,
    # sans rendre la suite rouge : une dette que personne ne voit est un angle mort.
    avis_parent = []
    avis_dirname = []
    zone = zone_operateur()
    for chemin in iterer_fichiers(racine, ".py"):
        for numero, ligne in lignes_code(chemin):
            if MOTIF_CWD.search(ligne):
                ecarts.append("cwd interdit : " + str(chemin) + ":" + str(numero))
            if MOTIF_PARENTS.search(ligne):
                dettes.append("parents[N] a ancrer : " + str(chemin) + ":" + str(numero))
            if MOTIF_CHAINE_DIRNAME.search(ligne):
                message = ("chaine dirname a ancrer : " + str(chemin) + ":" + str(numero)
                           + " -- deux niveaux comptes a la main (L-013)")
                if zone is not None and zone in chemin.parents:
                    dettes.append(message)
                else:
                    avis_dirname.append(message)
            if MOTIF_CHAINE_PARENT.search(ligne):
                avis_parent.append(str(chemin) + ":" + str(numero))
    if avis_dirname:
        print("[--] chaine dirname HORS ZONE : " + str(len(avis_dirname)) + " site(s)"
              + " (dette chiffree, non bloquante -- elle demande un ancrage par outil)"
              + " -- premier : " + avis_dirname[0])
    if avis_parent:
        print("[--] chaine .parent NON ancree : " + str(len(avis_parent)) + " site(s)"
              + " (dette chiffree, non bloquante) -- " + ", ".join(avis_parent[:4])
              + (" ..." if len(avis_parent) > 4 else ""))
    if strict:
        ecarts += dettes
        dettes = []
    return ecarts, dettes


def controler_noms(racine):
    """Ecarts de noms : tout objet (dossier ou fichier non-Python) est canonique.

    Troisieme sortie (exemptions) : les POINTS DE RESTAURATION de porte sont
    epargnes ET RENDUS -- un fichier epargne en silence serait un angle mort
    (friction 42, arbitrage createur 2026-09-16).
    """
    ecarts = []
    exemptions = []
    # Un domicile illisible se DIT (dette), il ne se tait pas : sans lui le
    # controle classerait des points de restauration en ecarts sans dire pourquoi.
    dettes = [AVIS_DOMICILE_BAK] if AVIS_DOMICILE_BAK else []
    for chemin in sorted(racine.rglob("*")):
        if doit_ignorer(racine, chemin):
            continue
        if chemin.is_dir():
            if not nom_objet_canonique(chemin.name):
                ecarts.append("dossier non canonique : " + str(chemin))
        elif chemin.suffix not in EXTENSIONS_CODE:
            if point_de_restauration(chemin.name):
                exemptions.append(
                    "point de restauration de porte : " + str(chemin)
                    + " -- artefact borne par le motif " + MOTIF_POINT_RESTAURATION.pattern
                    + " (proto-2 : point de restauration obligatoire)"
                )
            elif not nom_objet_canonique(chemin.name):
                ecarts.append("fichier non canonique : " + str(chemin))
    return ecarts, dettes, exemptions


def controler_flags(racine):
    """Ecarts de flags : kebab-case minuscules, jamais de majuscule ni underscore."""
    ecarts = []
    for chemin in iterer_fichiers(racine, ".py"):
        for numero, ligne in lignes_code(chemin):
            for flag in MOTIF_FLAG.findall(ligne):
                if not MOTIF_FLAG_CANONIQUE.match(flag):
                    ecarts.append(
                        "flag non canonique " + flag + " : " + str(chemin) + ":" + str(numero)
                    )
    return ecarts, []


def controler_imports(racine):
    """Ecarts d'import : un import ne peut jamais viser un fichier a TIRETS.

    Python interdit le tiret dans un identifiant : un module ecrit `a-tirets.py`
    n'est JAMAIS importable par `import a_tirets`. L'ecart est SIGNALE quand
    l'underscore du code correspond a un fichier existant qui porte un tiret
    (le tiret est alors une coquille qui ne se voit qu'a l'execution).
    """
    ecarts = []
    arborescence = {p.stem for p in racine.rglob("*.py")}
    arborescence |= {p.name for p in racine.rglob("*") if p.is_dir()}
    for chemin in iterer_fichiers(racine, ".py"):
        for numero, ligne in lignes_code(chemin):
            trouve = MOTIF_IMPORT.match(ligne)
            if not trouve:
                continue
            module = trouve.group(1)
            if module in arborescence:
                continue
            variante = module.replace("_", "-")
            if variante != module and variante in arborescence:
                ecarts.append(
                    "import impossible " + module + " : le fichier porte des TIRETS "
                    "(" + variante + ") et n'est jamais importable -- " + str(chemin) + ":" + str(numero)
                )
    if not AMORCE_DECLAREE:
        # B-4 est la moitie du controle : l'autre moitie (l'amorce presente ou
        # absente) ne peut pas juger sans la RECETTE d'amorce. Elle se DIT.
        return ecarts, [AVIS_AMORCE_INACTIVE]
    return ecarts, []


def prefixe_de(identifiant):
    """Prefixe d'un id (<PREFIXE>-<NNN>), ou None si la forme ne s'y prete pas."""
    if not isinstance(identifiant, str) or SEPARATEUR_PREFIXE not in identifiant:
        return None
    return identifiant.rsplit(SEPARATEUR_PREFIXE, 1)[0]


def listes_de_section(donnees, section):
    """Listes d'items d'une section : liste simple, ou dict de listes (l'entonnoir

    range ses items par type dans `files` : {type: [items]}). Une section peut
    etre un TUPLE de sections (les items d'un entonnoir vivent au vrac, dans les
    files-type ET dans le brin : les trois portent la meme famille d'ids, donc
    un seul controle doit les couvrir -- sinon un item deplace echappe au
    controle qui l'avait vu naitre).
    """
    sections = section if isinstance(section, tuple) else (section,)
    listes = []
    for nom in sections:
        valeur = donnees.get(nom)
        if isinstance(valeur, dict):
            listes += [x for x in valeur.values() if isinstance(x, list)]
        elif isinstance(valeur, list):
            listes.append(valeur)
    return listes


def ids_de_famille(racine, chemin, section, champ):
    """Ids d'une famille lus sur le disque : liste vide si absent ou illisible."""
    fichier = racine / chemin
    if not fichier.is_file():
        return []
    try:
        texte = fichier.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return []
    ids = []
    if section is None:
        for ligne in texte.splitlines():
            if not ligne.strip():
                continue
            try:
                entree = json.loads(ligne)
            except ValueError:
                continue
            valeur = entree.get(champ)
            if valeur:
                ids.append(valeur)
    else:
        try:
            donnees = json.loads(texte)
        except ValueError:
            return []
        for liste in listes_de_section(donnees, section):
            for entree in liste:
                if isinstance(entree, dict) and entree.get(champ):
                    ids.append(entree[champ])
    return ids


def prefixes_en_dur(racine):
    """Prefixes d'ids ATTRIBUES en dur dans le code (regle CV-009).

    Motif reel (2026-09-13, MO-030) : le pilote du cameleon fabriquait ses ids
    en concatenant un prefixe LITTERAL au numero du compteur, pendant que le
    pilote d'Optimus, LUI, lisait PREFIXE_ID de ses constantes. Deux copies du
    meme code, une seule regle respectee : un agent a donc pu croire que M-
    etait le prefixe de la Matrice et declarer des missions d'Optimus en M-
    (rangees du mauvais cote). Le controle des DONNEES ne peut pas voir cette
    cause : il ne juge que des ids deja emis. Ici on regarde la FABRIQUE de l'id.

    Detection : un litteral prefixe (deux lettres et un tiret, entre apostrophes)
    CONCATENE sur une ligne qui apparie un remplissage de zeros -- la signature
    d'une attribution d'identifiant numerote. Un prefixe seulement COMPARE
    (startswith) n'est pas fabrique a cet endroit : c'est une autre regle (les
    constantes de l'outil concerne).
    """
    ecarts = []
    for chemin in iterer_fichiers(racine, ".py"):
        for numero, ligne in lignes_code(chemin):
            if not MOTIF_ZFILL.search(ligne):
                continue
            trouve = MOTIF_PREFIXE_EN_DUR.search(ligne)
            if not trouve:
                continue
            ecarts.append(
                "prefixe en dur " + trouve.group(1) + "- : " + str(chemin) + ":" + str(numero)
                + " (a attribuer depuis ses constantes -- constants.py PREFIXE_ID ou"
                " listes.py PREFIXE_ITEM -- jamais recopie, revue CV-009)"
            )
    return ecarts, []


def controler_prefixes(racine):
    """Ecarts de prefixes : une famille = un prefixe, aucun prefixe partage.

    Quatre fautes detectees : (1) une famille porte plusieurs prefixes (derive) ;
    (2) deux familles partagent un prefixe (ambiguite qui attend son heure) ;
    (3) une famille vivante emet un prefixe declare MORT ; (4) un prefixe est
    ATTRIBUE en dur dans le code au lieu de venir des constantes (la fabrique
    de l'id, pas l'id lui-meme : c'est la cause, invisible dans les donnees).
    """
    ecarts, _ = prefixes_en_dur(racine)
    prefixes = {}
    for famille, chemin, section, champ, attendu in FAMILLES_IDS:
        ids = ids_de_famille(racine, chemin, section, champ)
        if not ids:
            continue
        trouves = sorted({p for p in (prefixe_de(i) for i in ids) if p})
        prefixes[famille] = (attendu, trouves)
        if len(trouves) > 1:
            ecarts.append(
                "famille " + famille + " a plusieurs prefixes : " + ", ".join(trouves)
            )
        for prefixe in trouves:
            if prefixe != attendu:
                ecarts.append(
                    "famille " + famille + " : prefixe " + prefixe + "-"
                    + " (attendu " + attendu + "-, revue CV-011)"
                )
            if prefixe in PREFIXES_MORTS:
                ecarts.append(
                    "prefixe MORT " + prefixe + "- re-emis par " + famille
                    + " (revue CV-009 : il a ete attribue a une autre famille)"
                )
    for nom, (attendu, trouves) in prefixes.items():
        for autre, (_, autres) in prefixes.items():
            if autre <= nom:
                continue
            communs = sorted(set(trouves) & set(autres))
            if communs:
                ecarts.append(
                    "prefixe partage " + ", ".join(communs) + "- entre " + nom
                    + " et " + autre
                )
    return ecarts, []


def categories_projet(racine):
    """Dossiers-categories que le motif de racine (M-076) peut masquer.

    Trou mesure (fiche I-00, controle B-3) : le controle ne regardait que les
    PILOTES, alors que la meme panne frappe les OUTILS -- leur `main.py`
    importe leurs sous-dossiers (`ajouter`, `lire`, `verifier`...) par nom nu
    des que `data/commun/` est pose dans `sys.path`.
    """
    categories = set()
    for pilote in sorted(racine.rglob(NOM_DOSSIER_PILOTE)):
        if not pilote.is_dir() or doit_ignorer(racine, pilote):
            continue
        for enfant in sorted(pilote.iterdir()):
            if enfant.is_dir() and not enfant.name.startswith("_"):
                categories.add(enfant.name)
    outils = racine / DOSSIER_OUTILS[0] / DOSSIER_OUTILS[1] / DOSSIER_OUTILS[2]
    if outils.is_dir():
        for outil in sorted(outils.iterdir()):
            if not outil.is_dir() or doit_ignorer(racine, outil):
                continue
            for enfant in sorted(outil.iterdir()):
                if enfant.is_dir() and not enfant.name.startswith("_"):
                    categories.add(enfant.name)
    return categories


def controler_collisions(racine):
    """Ecarts de collision de nom : un module partage ne masque jamais une categorie.

    Le motif de racine (M-076) pose `data/commun/` dans sys.path. Un module
    `commun/X.py` dont le nom est AUSSI un dossier-categorie d'un pilote
    (`pilote/X/`) est resolu COMME MODULE et masque le paquet : le pilote meurt
    en ModuleNotFoundError. Regression du 2026-09-13 : `commun/profil.py` a tue
    le pilote maintenance alors que `pilote/profil/` existait.

    B-3 etendu (pas 1) : les categories des OUTILS comptent aussi.
    """
    ecarts = []
    categories = categories_projet(racine)
    if not categories:
        return ecarts, []
    for partage in sorted(racine.rglob(NOM_DOSSIER_PARTAGE)):
        if not partage.is_dir() or doit_ignorer(racine, partage):
            continue
        for module in sorted(partage.glob("*.py")):
            if module.stem in categories:
                ecarts.append(
                    "collision de nom : " + str(module) + " masque le dossier-categorie "
                    "de pilote " + module.stem + "/ (renommer le module partage)"
                )
    return ecarts, []


# --- PAS 1 : les deux controles du garde de resolution ---------------------

def familles_natives():
    """Familles autorisees en import par NOM NU : la bibliotheque standard.

    Source UNIQUE : l'interpreteur lui-meme (`sys.stdlib_module_names`),
    jamais une liste recopiee. La declaration du chargeur
    (`FAMILLES_AUTORISEES`, pas 2) remplacera ce puits le jour ou elle naitra :
    une seule regle, un seul domicile (M-076).
    """
    return set(sys.stdlib_module_names)


def noms_internes(racine):
    """Noms qu'un import par NOM NU peut atteindre DANS le projet.

    Un nom nu ne dit pas son fichier : il est resolu par le `sys.path` du
    moment. Sont retenus les noms de module existants ET les noms de dossier --
    les deux formes que le projet a REELLEMENT vues se masquer (38
    `constants.py`, et `commun/profil.py` qui a tue un pilote).
    """
    noms = {p.stem for p in racine.rglob("*.py") if not doit_ignorer(racine, p)}
    noms |= {p.name for p in racine.rglob("*")
             if p.is_dir() and not doit_ignorer(racine, p)}
    return noms


def noms_nus_importes(chemin):
    """Imports par NOM NU d'un fichier : (numero, nom). Lecture AST seule."""
    try:
        arbre = ast.parse(chemin.read_text(encoding="utf-8"))
    except (UnicodeDecodeError, SyntaxError, OSError):
        return
    for noeud in ast.walk(arbre):
        if isinstance(noeud, ast.Import):
            for alias in noeud.names:
                if "." not in alias.name:
                    yield noeud.lineno, alias.name
        elif isinstance(noeud, ast.ImportFrom):
            if noeud.level == 0 and noeud.module and "." not in noeud.module:
                yield noeud.lineno, noeud.module


def dans_perimetre(chemin, racine, perimetres):
    """Vrai si le fichier est DANS un perimetre declare (relatif a la racine)."""
    try:
        relatif = chemin.relative_to(racine)
    except ValueError:
        return False
    for perimetre in perimetres:
        motif = Path(str(perimetre).strip())
        if relatif == motif or motif in relatif.parents:
            return True
    return False


def controler_resolution(racine, perimetre=None):
    """B-1 : un import ne vise jamais l'interieur par un NOM NU.

    Le nom nu est la CLASSE DE PANNE entiere : deux homonymes se masquent en
    silence, et l'ordre du `sys.path` decide a la place du code. Le garde lit le
    CODE (AST) -- il n'execute jamais ce qu'il controle.

    Le blocage porte sur le PERIMETRE MIGRE ; hors de la, l'occurrence est une
    DETTE CHIFFREE qui ne doit JAMAIS remonter (S-4 : sans cela, le garde ne
    pourrait pas s'allumer avant d'avoir tout migre).
    """
    perimetres = tuple(perimetre) if perimetre else PERIMETRE_MIGRE
    natifs = familles_natives()
    atteignables = noms_internes(racine)
    ecarts, dettes = [], []
    total = 0
    for chemin in iterer_fichiers(racine, ".py"):
        for numero, nom in noms_nus_importes(chemin):
            if nom in natifs or nom not in atteignables:
                continue
            total += 1
            message = ("import par NOM NU " + nom + " : " + str(chemin) + ":" + str(numero)
                       + " -- un nom nu ne dit pas QUEL fichier il designe ; utiliser "
                       + SYNTAXE_POINTEE + " ou " + SYNTAXE_CHARGER)
            if dans_perimetre(chemin, racine, perimetres):
                ecarts.append(message)
            else:
                dettes.append(message)
    dettes.insert(0, "DETTE CHIFFREE noms-nus = " + str(total) + " (elle ne remonte JAMAIS)")
    return ecarts, dettes


def insertions_de(chemin):
    """Insertions de chemin d'un fichier : (numero, constante, calculee)."""
    try:
        contenu = chemin.read_text(encoding="utf-8")
        arbre = ast.parse(contenu)
    except (UnicodeDecodeError, SyntaxError, OSError):
        return
    for noeud in ast.walk(arbre):
        if not isinstance(noeud, ast.Call):
            continue
        fonction = noeud.func
        if not isinstance(fonction, ast.Attribute) or fonction.attr not in ("insert", "append"):
            continue
        valeur = fonction.value
        if not (isinstance(valeur, ast.Attribute) and valeur.attr == "path"
                and isinstance(valeur.value, ast.Name) and valeur.value.id == "sys"):
            continue
        constante = any(isinstance(arg, ast.Constant) and isinstance(arg.value, str)
                        for arg in noeud.args)
        source = ast.get_source_segment(contenu, noeud) or ""
        calculee = any(motif in source for motif in MOTIFS_CHEMIN_CALCULE)
        yield noeud.lineno, constante, calculee


def controler_insertions(racine, perimetre=None):
    """B-2 : la fabrique d'insertions de chemin est surveillee (MO-059).

    Toute insertion hors amorce est signalee. Un argument non resolvable
    statiquement n'est PAS devine : il est declare DETTE AVOUEE avec son
    `fichier:ligne` (deviner serait pire que se taire). Une insertion qui CALCULE
    son chemin (dirname/abspath/parent) est nommee comme telle (L-013 : aucun
    chemin compte a la main).
    """
    perimetres = tuple(perimetre) if perimetre else PERIMETRE_MIGRE
    ecarts, dettes = [], []
    total = 0
    for chemin in iterer_fichiers(racine, ".py"):
        for numero, constante, calculee in insertions_de(chemin):
            total += 1
            if calculee:
                message = ("insertion qui CALCULE son chemin : " + str(chemin) + ":" + str(numero)
                           + " -- un chemin se DESIGNE, il ne se compte pas a la main (L-013)")
            elif not constante:
                message = ("DETTE AVOUEE insertion non resolvable : " + str(chemin) + ":"
                           + str(numero) + " -- le chemin est calcule : declare, jamais devine")
            else:
                message = ("insertion de chemin hors amorce : " + str(chemin) + ":" + str(numero)
                           + " -- la seule insertion autorisee est l'amorce de porte")
            if dans_perimetre(chemin, racine, perimetres):
                ecarts.append(message)
            else:
                dettes.append(message)
    dettes.insert(0, "DETTE CHIFFREE insertions = " + str(total) + " (elle ne remonte JAMAIS)")
    if not AMORCE_DECLAREE:
        dettes.insert(0, AVIS_AMORCE_INACTIVE)
    return ecarts, dettes


