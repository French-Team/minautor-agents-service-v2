TEMPLATE_README = '''# {nom}

## Description
{description}

## Famille et forme
Famille SUPER-COMBOS : main.py + entry.py A LA RACINE + fonctions/.
Ce n'est PAS la forme des outils de la Matrice (CV-001 : main.py +
<categorie>/entry.py) : sur un outil de la Matrice, entry.py a la racine n'existe pas.

## Structure
- main.py : point d'entree global
- entry.py : orchestrateur de l'outil (A LA RACINE)
- fonctions/{nom_lower}.py : fonctions atomiques

## Commandes
```
{nom} <commande1> --param <valeur>
{nom} <commande2>
```
'''


def main():
    parser = argparse.ArgumentParser(description="Creer un squelette d'outil")
    parser.add_argument("nom", help="Nom de l'outil (ex: bdd-nouveau)")
    parser.add_argument("--description", required=True, help="Description de l'outil")
    args = parser.parse_args()

    nom = args.nom
    nom_lower = nom.replace("-", "_")
    base_path = Path(__file__).parent / nom

    if base_path.exists():
        print(f"Outil deja existant: {base_path}")
        return 1

    # Creer les dossiers
    (base_path / "fonctions").mkdir(parents=True)

    # Ecrire les fichiers
    (base_path / "main.py").write_text(
        TEMPLATE_MAIN.format(nom=nom, description=args.description, nom_lower=nom_lower),
        encoding="utf-8"
    )
    (base_path / "entry.py").write_text(
        TEMPLATE_ENTRY.format(nom=nom, nom_lower=nom_lower),
        encoding="utf-8"
    )
    (base_path / "fonctions" / f"{nom_lower}.py").write_text(
        TEMPLATE_FONCTION.format(nom=nom, nom_lower=nom_lower),
        encoding="utf-8"
    )
    (base_path / "README.md").write_text(
        TEMPLATE_README.format(nom=nom, description=args.description, nom_lower=nom_lower),
        encoding="utf-8"
    )

    print(f"Outil cree: {base_path}")
    print("FORME : famille SUPER-COMBOS -- main.py + entry.py A LA RACINE + fonctions/")
    print("  - main.py")
    print("  - entry.py")
    print(f"  - fonctions/{nom_lower}.py")
    print("  - README.md")
    print("Ce n'est PAS la forme CV-001 des outils de la Matrice (main.py + <categorie>/entry.py).")
    print("\\nA completer : adapter les commandes, fonctions, BDD selon besoins.")
    return 0


if __name__ == "__main__":
    sys.exit(main())