def lire_json(chemin):
    # Lire un JSON ; une absence est DITE par l appelant, jamais devinee.
    if not chemin.is_file():
        return None
    with open(chemin, "r", encoding="utf-8") as fichier:
        return json.load(fichier)


def lancer_outil(chemin, arguments):
    # Lancer un outil de la Matrice : (code, sortie) ; un outil absent ne casse rien.
    if not chemin.is_file():
        return 127, "outil introuvable : " + str(chemin)
    resultat = subprocess.run(
        [sys.executable, str(chemin)] + arguments,
        capture_output=True, text=True,
    )
    return resultat.returncode, (resultat.stdout or "") + (resultat.stderr or "")
