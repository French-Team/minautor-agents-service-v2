"""Point d'entree global de l'outil bdd-sessions.

Role : DIRIGER (parser la commande, router vers la categorie).
Aucune logique metier ici (convention-architecture-outils).

Usage :
    python main.py ajouter --session "..." --tags "a,b" [--source "..."]
    python main.py lire [--tag <tag>]
    python main.py resume --derniere   (la DERNIERE session, lecture bornee)
    python main.py etat                (l'ETAT seul : ouverte | fermee | aucune -- MO-121)
    python main.py retiqueter --id S-0XX --tags "a,b" [--motif "..."]  (corrige les tags
                                       d'une entree, TRACE conservee -- MO-122)
    python main.py verifier

"""
import sys

from ajouter.entry import executer as ajouter_executer
from etat.entry import executer as etat_executer

from lire.entry import executer as lire_executer
from retiqueter.entry import executer as retiqueter_executer

from resume.entry import executer as resume_executer
from verifier.entry import executer as verifier_executer

COMMANDES = {
    "ajouter": ajouter_executer,
    "etat": etat_executer,

    "lire": lire_executer,
    "retiqueter": retiqueter_executer,

    "resume": resume_executer,
    "verifier": verifier_executer,
}


def principal(arguments):
    if not arguments or arguments[0] not in COMMANDES:
        print(__doc__)
        return 2
    return COMMANDES[arguments[0]](arguments[1:])


if __name__ == "__main__":
    from sac_a_dos import envelopper
    sys.exit(envelopper(principal, sys.argv[1:]))
