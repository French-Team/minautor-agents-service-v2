NOM_ENTONNOIR = "entonnoir-files.json"
CHEMIN_ENTONNOIR = REPERTOIRE_PILOTE / NOM_ENTONNOIR
NOM_HISTORIQUE = "historiques-missions.jsonl"
CHEMIN_HISTORIQUE = REPERTOIRE_DATA / NOM_HISTORIQUE

