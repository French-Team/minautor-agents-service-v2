      {
        "besoin": "Lancer le combo corriger-fichier",
        "action": "procedure",
        "etapes": [
          "python3 cerveau-projet/agents/tools/combos/combos-moteur/combos-moteur.py cerveau-projet/combos/combo-corriger-fichier/definition-combo.json"
        ],
        "regle": "COMBO CORRIGER-FICHIER : valider le fichier modifie."
      },
      {
        "besoin": "Lancer le combo controle-impacts",
        "action": "procedure",
        "etapes": [
          "python3 cerveau-projet/agents/tools/combos/combos-moteur/combos-moteur.py cerveau-projet/combos/combo-controle-impacts/definition-combo.json"
