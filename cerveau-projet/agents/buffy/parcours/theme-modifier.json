        "regle": "Les erreurs hors mission sont SIGNALEES, jamais ignorees."
      },
      {
        "besoin": "Valider le resultat (RVAV)",
        "action": "procedure",
        "etapes": [
          "Lire : cerveau-projet/agents/regles-immuables/general/rvav-workflow.md"
        ],
        "regle": "REGLE IMMUABLE RVAV."
      },
      {
        "besoin": "Ajouter les lecons dans corrections.md",
        "action": "procedure",
        "etapes": [
          "python3 cerveau-projet/agents/tools/ajouter/ajouter-contenu-fichier/ajouter-contenu-fichier.py cerveau-projet/agents/buffy/corrections.md <lecon>",
          "python3 cerveau-projet/agents/tools/corriger/corriger-accents-zones-sensibles/corriger-accents-zones-sensibles.py cerveau-projet/agents/buffy/corrections.md --all"
