      {
        "besoin": "Activer Themis pour auditer ma mission",
        "action": "procedure",
        "etapes": [
          "python3 cerveau-projet/agents/tools/activer/activer-agent-principal/activer-agent-principal.py activer <session> themis '<raison>'"
        ],
        "regle": "THEMIS AVANT JANUS."
      },
      {
        "besoin": "Retour de Themis recu ?",
        "action": "procedure",
        "etapes": [
          "OUI -> fin-modifier",
          "NON -> re-essai"
        ],
        "regle": "PATTERN RE-ESSAI."
      }
    ]
